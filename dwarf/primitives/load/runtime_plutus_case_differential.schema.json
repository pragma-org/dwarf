{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime_plutus_case_differential params",
  "type": "object",
  "required": [
    "runtime_metadata_path",
    "target_node",
    "reference_node",
    "families"
  ],
  "properties": {
    "runtime_metadata_path": {
      "type": "string",
      "minLength": 1
    },
    "target_node": {
      "type": "string",
      "minLength": 1
    },
    "reference_node": {
      "type": "string",
      "minLength": 1
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cek-integer-division",
          "cek-value-structure",
          "crypto-builtins",
          "bls12-381-builtins"
        ]
      }
    }
  },
  "additionalProperties": false
}
