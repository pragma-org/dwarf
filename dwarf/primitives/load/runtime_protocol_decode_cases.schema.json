{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeProtocolDecodeCases",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {"required": ["profile_id"], "not": {"required": ["runtime_root"]}},
    {"required": ["runtime_root"], "not": {"required": ["profile_id"]}}
  ],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,80}$"},
    "runtime_root": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "helper_script": {"type": "string", "minLength": 1},
    "python_bin": {"type": "string", "minLength": 1},
    "attempts_per_case": {"type": "integer", "minimum": 1},
    "duration_seconds": {"type": "number", "minimum": 0},
    "workload_digest": {"type": "string", "const": "sha256:1ab6db08d45f22f42b1333c255ed07ac9dc57ecacb69ee7c645ecfd451c4225e"},
    "response_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "progress_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "observation_seconds": {"type": "number", "minimum": 0.5},
    "trace_timeout_seconds": {"type": "number", "minimum": 0.5},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "expected_helper_exit": {"type": "integer"}
  }
}
