{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeCardanoMeasurementCalibration",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {"required": ["profile_id"], "not": {"required": ["runtime_root"]}},
    {"required": ["runtime_root"], "not": {"required": ["profile_id"]}}
  ],
  "properties": {
    "helper_script": {"type": "string", "minLength": 1},
    "python_bin": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,80}$"},
    "runtime_root": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "attempts": {"type": "integer", "minimum": 30, "maximum": 10000},
    "response_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "observation_seconds": {"type": "number", "minimum": 0.5, "maximum": 30},
    "trace_timeout_seconds": {"type": "number", "minimum": 0.5, "maximum": 120},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "expected_helper_exit": {"type": "integer"}
  }
}
