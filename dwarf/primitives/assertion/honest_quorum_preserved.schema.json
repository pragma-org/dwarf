{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "honest_node_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tolerance_slots": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Allowed slot spread between the honest nodes' final tips; 0 requires hash-identical tips."
    }
  },
  "required": [
    "honest_node_ids",
    "minimum_fraction"
  ],
  "additionalProperties": false
}
