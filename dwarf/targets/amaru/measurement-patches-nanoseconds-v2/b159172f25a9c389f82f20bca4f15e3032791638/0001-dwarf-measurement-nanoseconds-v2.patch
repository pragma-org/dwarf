+        protocols::measurement::BLOCKFETCH_QUEUE_RESIDENCE,
+        peer,
+        request_id = queued.fetch.id,
+        outcome = outcome.to_string(),
+        elapsed_nanos,
+        elapsed_micros,
+        queue_depth = 1
