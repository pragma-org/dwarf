cabal-version: 3.0
name: dwarf-cardano-cbor-conformance
version: 0.1.0.0
build-type: Simple

executable dwarf-cardano-cbor-conformance
  main-is: Main.hs
  hs-source-dirs: src
  default-language: GHC2021
  ghc-options: -O2 -Wall
  build-depends:
      aeson
    , base >= 4.18 && < 5
    , bytestring
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , deepseq
