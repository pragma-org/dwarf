cabal-version: 3.0
name: dwarf-cardano-plutus-conformance
version: 0.1.0.0
build-type: Simple

executable dwarf-cardano-plutus-conformance
  main-is: Main.hs
  hs-source-dirs: src
  default-language: GHC2021
  ghc-options: -O2 -Wall
  build-depends:
      aeson
    , base >= 4.18 && < 5
    , bytestring
    , cborg
    , mtl
    , plutus-core
    , plutus-ledger-api
