+-- | Native V2 request/body handling metadata only. Every diagnostic thunk is
+-- forced under the synchronous-only guard. No transaction body is serialized.
+{-# NOINLINE emitDwarfTxSubmission #-}
+emitDwarfTxSubmission :: String -> Word64 -> Word64 -> String -> String -> String
+                      -> Int -> Int -> Int -> Int -> Maybe Word64 -> Maybe Word64 -> ()
+emitDwarfTxSubmission phase peerSession requestId peerId txId outcome txIndex txCount pending inflight started ended =
+  unsafePerformIO $ do
+    sink <- tryHeaderInstrumentation (evaluate measurementHandle)
+    case sink of
+      Right (Just lock) -> do
+        emitted <- tryHeaderInstrumentation $ do
+          (start, end) <- case (started, ended) of
+            (Just a, Just b) | a <= b -> pure (a, b)
+            _ -> ioError (userError "unavailable clock")
+          let boundedTxId = take 257 txId
+              boundedPeerId = take 257 peerId
+          if peerSession == 0 || requestId == 0 || txCount < 1 || txCount > 65536
+              || txIndex < 1 || txIndex > txCount || pending < 0 || pending > 65536
+              || inflight < 0 || inflight > 65536 || null boundedTxId
+              || length boundedTxId > 256 || null boundedPeerId || length boundedPeerId > 256
+              || any (\c -> c < ' ' || c > '~') boundedPeerId
+              || any (\c -> c < ' ' || c > '~') boundedTxId
+            then ioError (userError "unavailable tx metadata")
+            else pure ()
+          encoded <- evaluate $ LBS.toStrict $ encode $ object
+            [ "schema_version" .= ("v1" :: String)
+            , "target" .= ("cardano-node::measurement" :: String)
+            , "event" .= ("txsubmission_residence" :: String)
+            , "boundary" .= ("inbound-v2-request-body-handling" :: String)
+            , "phase" .= phase
+            , "trace_session" .= dwarfTraceSession
+            , "peer_session" .= peerSession
+            , "peer_id" .= boundedPeerId
+            , "request_id" .= requestId
+            , "tx_id" .= boundedTxId
+            , "outcome" .= outcome
+            , "tx_index" .= txIndex
+            , "request_tx_count" .= txCount
+            , "pending_depth" .= pending
+            , "inflight_depth" .= inflight
+            , "started_monotonic_ns" .= start
+            , "ended_monotonic_ns" .= end
+            ]
+          withMVar lock $ \handle -> BS.hPutStrLn handle encoded
+        case emitted of
+          Right () -> pure ()
+          Left _ -> do
+            _ <- tryHeaderInstrumentation $ withMVar lock $ \handle ->
+              BS.hPutStrLn handle
+                "{\"schema_version\":\"v1\",\"target\":\"cardano-node::measurement\",\"event\":\"txsubmission_residence\",\"boundary\":\"inbound-v2-request-body-handling\",\"phase\":\"unavailable\"}"
+            pure ()
+      _ -> pure ()
