{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pragma-org/dwarf/blob/main/dwarf/spec/v1/measurement-coverage-map.schema.json",
  "title": "DWARF measurement coverage applicability map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "provenance", "client_requirement_rules", "surface_rules", "family_rules", "entry_rules", "evidence_rules"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"const": "measurement-coverage-v1"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "surface_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "family_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "client_requirement_rules": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {"$ref": "#/$defs/clientRequirement"}
    },
    "entry_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "measurements"],
        "properties": {
          "id": {"pattern": "^(TM|RR)-[0-9]{3}$"},
          "measurements": {"$ref": "#/$defs/measurementIds"}
        }
      }
    },
    "evidence_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "implementation", "measurements"],
        "properties": {
          "card_id": {"pattern": "^[0-9]{2}$"},
          "implementation": {"enum": ["amaru", "cardano-node"]},
          "measurements": {"$ref": "#/$defs/measurementIds"}
        }
      }
    }
  },
  "$defs": {
    "measurementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(amaru|cardano)-[a-z0-9-]+$"}
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "measurements", "prerequisite", "can_prove", "non_claims"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "measurements": {"$ref": "#/$defs/measurementIds"},
        "prerequisite": {"type": "string", "minLength": 1},
        "can_prove": {"type": "string", "minLength": 1},
        "non_claims": {"type": "string", "minLength": 1}
      }
    },
    "clientImplementation": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary", "recipe_documented", "measurements", "scenarios", "limitation", "missing_step"],
      "properties": {
        "boundary": {"enum": ["complete", "partial", "none"]},
        "recipe_documented": {"type": "boolean"},
        "measurements": {"$ref": "#/$defs/measurementIds"},
        "scenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limitation": {"type": "string", "minLength": 1},
        "missing_step": {"type": "string", "minLength": 1}
      }
    },
    "clientRequirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "kind", "description", "source_url", "interpretation", "implementations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["Functional requirement", "Non-functional requirement"]},
        "description": {"type": "string", "minLength": 1},
        "source_url": {"const": "https://gist.github.com/KtorZ/9e5fd34eb993d0bbc5158984e8be5792"},
        "interpretation": {"type": "string", "minLength": 1},
        "implementations": {
          "type": "object", "additionalProperties": false,
          "required": ["amaru", "cardano-node"],
          "properties": {"amaru": {"$ref": "#/$defs/clientImplementation"}, "cardano-node": {"$ref": "#/$defs/clientImplementation"}}
        }
      }
    }
  }
}
