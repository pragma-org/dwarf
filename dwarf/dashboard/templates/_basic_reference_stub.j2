{% extends "_base.j2" %}
{% block main %}
<span class="eyebrow">{{ eyebrow or 'Reference' }}</span>
<h1>{{ page_title }}</h1>
<section class="basic-only" aria-label="Basic summary">
  <p class="b-note">{{ summary }}</p>
  <div class="b-loop" style="margin-top:20px">
    <div class="b-step"><span class="num">FULL PAGE</span>
      <h3>Full reference</h3><p>{{ advanced_hint or 'This is a long reference document.' }}</p>
      <p>This concise page links to the supported operator and reference surfaces where they are needed.</p></div>
  </div>
</section>
{% endblock %}
