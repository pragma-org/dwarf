{% extends "_base.j2" %}
{% macro badge(value, kind) -%}<span class="measurement-coverage__badge" data-{{ kind }}="{{ value|lower }}">{{ value }}</span>{%- endmacro %}
{% macro technical_id(label, value) -%}
<details class="measurement-coverage__technical-id"><summary>{{ label }}</summary><code>{{ value }}</code></details>
{%- endmacro %}
{% macro result_card(row, section) -%}
<details class="measurement-coverage__row" data-search="{{ row.search_text }}" data-implementations="{{ row.implementations|join(' ')|lower }}" data-sources="{{ row.sources|join(' ')|lower }}" data-status="{{ row.status|lower }}">
  <summary class="measurement-coverage__row-summary">
    <span class="measurement-coverage__row-lead">
      <span class="measurement-coverage__human-id">{{ row.id }}</span>
      <span class="measurement-coverage__row-title">{{ row.title }}</span>
      <span class="measurement-coverage__meaning">{{ row.meaning }}</span>
    </span>
    <span class="measurement-coverage__row-facts">
      {{ badge(row.status, 'state') }}
      <span class="measurement-coverage__implementations">{% for implementation in row.implementations %}{{ badge(implementation, 'implementation') }}{% endfor %}</span>
      <span>{{ row.tap_summary.applicable }} applicable · {{ row.tap_summary.verified }} verified</span>
      <span>{{ row.scenario_count }} scenario{{ '' if row.scenario_count == 1 else 's' }}</span>
    </span>
    <span class="measurement-coverage__coverage-statement">{{ row.coverage_statement }}</span>
    <span class="measurement-coverage__summary-links">
      {% if section.id in ('threats', 'risks') %}<a href="/learn/threat-coverage">Open {{ 'threat' if section.id == 'threats' else 'risk' }} map</a>{% else %}<a href="/learn/coverage">Open scenario coverage</a>{% endif %}
      <a href="/learn/measurements">Open measurement model</a>
    </span>
  </summary>
  <div class="measurement-coverage__detail">
    <details class="measurement-coverage__detail-section" data-detail="taps">
      <summary>Measurement taps</summary>
      {% for group in row.tap_groups %}
      <details class="measurement-coverage__tap-group">
        <summary><span>{{ group.title }}</span><span>{{ group.taps|length }} tap{{ '' if group.taps|length == 1 else 's' }}</span></summary>
        <ul>
          {% for tap in group.taps %}
          <li>
            <span class="measurement-coverage__tap-name"><a href="{{ tap.url }}">{{ tap.title }}</a></span>
            {{ badge(tap.source, 'source') }} {{ badge(tap.status, 'state') }}
            {{ technical_id('Technical identifier', tap.id) }}
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endfor %}
    </details>

    <details class="measurement-coverage__detail-section" data-detail="scenarios">
      <summary>Scenarios</summary>
      {% if row.scenarios %}
      <ul class="measurement-coverage__initial-list">
        {% for scenario in row.scenarios[:3] %}<li data-list-item="true"><a href="{{ scenario.url }}">{{ scenario.title }}</a>{{ technical_id('Scenario identifier', scenario.id) }}</li>{% endfor %}
      </ul>
      {% if row.scenarios|length > 3 %}
      <template class="measurement-coverage__more-items">{% for scenario in row.scenarios[3:] %}<li data-list-item="true"><a href="{{ scenario.url }}">{{ scenario.title }}</a>{{ technical_id('Scenario identifier', scenario.id) }}</li>{% endfor %}</template>
      <button type="button" class="measurement-coverage__show-all" data-action="show-all">Show all {{ row.scenario_count }} scenarios</button>
      {% endif %}
      {% else %}<p>No current scenario maps to this entry.</p>{% endif %}
    </details>

    <details class="measurement-coverage__detail-section" data-detail="evidence">
      <summary>Evidence</summary>
      {% if row.evidence %}
      <div class="measurement-coverage__initial-list">
        {% for item in row.evidence[:3] %}
        <article class="measurement-coverage__evidence-card" data-list-item="true"><h4>Card {{ item.card_id }} · {{ item.implementation }}</h4><p><a href="{{ item.url }}">Open retained run evidence</a> · {{ item.measurement_count }} measurement{{ '' if item.measurement_count == 1 else 's' }}</p>{{ technical_id('Run and scenario identifiers', item.run_id ~ ' · ' ~ item.scenario_id) }}</article>
        {% endfor %}
      </div>
      {% if row.evidence|length > 3 %}
      <template class="measurement-coverage__more-items">{% for item in row.evidence[3:] %}<article class="measurement-coverage__evidence-card" data-list-item="true"><h4>Card {{ item.card_id }} · {{ item.implementation }}</h4><p><a href="{{ item.url }}">Open retained run evidence</a> · {{ item.measurement_count }} measurements</p>{{ technical_id('Run and scenario identifiers', item.run_id ~ ' · ' ~ item.scenario_id) }}</article>{% endfor %}</template>
      <button type="button" class="measurement-coverage__show-all" data-action="show-all">Show all {{ row.evidence|length }} evidence records</button>
      {% endif %}
      {% else %}<p>No retained non-vacuous client-card evidence maps to this entry.</p>{% endif %}
    </details>

    <details class="measurement-coverage__detail-section" data-detail="workload">
      <summary>Workload prerequisite</summary>
      <ul><li>{{ row.prerequisite|truncate(220, True) }}</li></ul>
      <details class="measurement-coverage__technical-text"><summary>Full technical text</summary><p>{{ row.prerequisite }}</p></details>
    </details>

    <details class="measurement-coverage__detail-section" data-detail="claims">
      <summary>Claims and limits</summary>
      <h4>What this measurement can prove</h4><ul><li>{{ row.coverage_statement }}</li></ul>
      <h4>What it does not prove</h4><ul><li>{{ row.non_claims|truncate(220, True) }}</li></ul>
      <details class="measurement-coverage__technical-text"><summary>Full technical text</summary><p><strong>Proof:</strong> {{ row.can_prove }}</p><p><strong>Non-claims:</strong> {{ row.non_claims }}</p></details>
    </details>
  </div>
</details>
{%- endmacro %}
{% macro client_requirement_card(row) -%}
<details class="measurement-coverage__row measurement-coverage__client-row" data-search="{{ row.search_text }}" data-implementations="amaru cardano-node" data-sources="{{ row.sources|join(' ')|lower }}" data-status="{{ row.status|lower }}">
  <summary class="measurement-coverage__row-summary">
    <span class="measurement-coverage__row-lead"><span class="measurement-coverage__human-id">{{ row.kind }}</span><span class="measurement-coverage__row-title">{{ row.title }}</span><span class="measurement-coverage__meaning">{{ row.meaning }}</span></span>
    <span class="measurement-coverage__row-facts">{% for key, implementation in row.implementations.items() %}<span class="measurement-coverage__badge" data-implementation="{{ key }}">{{ implementation.label }} · {{ implementation.status }}</span>{% endfor %}<span class="measurement-coverage__badge">{{ row.measurement_count }} applicable · {{ row.verified_measurement_count }} verified taps</span><span class="measurement-coverage__badge">{{ row.scenario_count }} scenarios</span></span>
    <span class="measurement-coverage__coverage-statement">{{ row.interpretation }}</span>
    <span class="measurement-coverage__summary-links"><a href="{{ row.source_url }}">Client source</a><a href="/run">Open /run</a></span>
  </summary>
  <div class="measurement-coverage__detail">
    {% for key, implementation in row.implementations.items() %}
    <details class="measurement-coverage__detail-section" data-detail="{{ key }}">
      <summary>{{ implementation.label }} · {{ implementation.status }}</summary>
      <p>{{ payload.client_readiness_definitions[implementation.status] }}</p>
      <h4>Measurement taps</h4><ul>{% for tap in implementation.measurements %}<li><a href="{{ tap.url }}">{{ tap.title }}</a> {{ badge(tap.source, 'source') }} {{ badge(tap.status, 'state') }}{{ technical_id('Technical identifier', tap.id) }}</li>{% endfor %}</ul>
      <h4>Proven scenarios and retained evidence</h4>{% if implementation.evidence %}<ul>{% for item in implementation.evidence %}<li><a href="{{ item.url }}">Retained run {{ item.run_id }}</a>{{ technical_id('Scenario identifier', item.scenario_id) }}</li>{% endfor %}</ul>{% else %}<p>No retained non-vacuous evidence proves this exact category boundary.</p>{% endif %}
      <h4>Compatible scenarios</h4><ul>{% for scenario in implementation.scenarios %}<li><a href="{{ scenario.url }}">{{ scenario.title }}</a>{{ technical_id('Scenario identifier', scenario.id) }}</li>{% endfor %}</ul>
      <h4>What is measured now</h4><p>{{ row.description }}</p>
      <h4>What is not measured or claimed</h4><p>{{ implementation.limitation }}</p>
      <h4>Smallest next step</h4><p>{{ implementation.missing_step }}</p>
      <p><a href="/run">Open the run wizard</a>{% if implementation.recipe_documented %} · Documented /run path available{% else %} · A concise recipe is still required{% endif %}</p>
    </details>
    {% endfor %}
  </div>
</details>
{%- endmacro %}

{% block main %}
<div class="measurement-coverage" data-initial-page-size="10">
  <span class="eyebrow">Learn · Evidence-aware observability</span>
  <h1>Measurement coverage</h1>
  <p class="lede">See where DWARF measurements apply and where retained real-node evidence verifies them.</p>
  <p><a href="/learn/measurements">Measurement model</a> · <a href="/learn/coverage">Catalog coverage</a> · <a href="/learn/threat-coverage">Threat and risk map</a></p>
  <p><strong>Child-friendly explanation:</strong> A tool can fit a job without having been used. This page shows both the tools that fit and the saved tests that used them.</p>

  <section class="measurement-coverage__overview" aria-labelledby="coverage-overview-title">
    <h2 id="coverage-overview-title">Choose a coverage view</h2>
    <div class="measurement-coverage__overview-grid">
      {% for item in payload.overview %}
      <button type="button" class="measurement-coverage__overview-tile" data-overview-id="{{ item.id }}" data-coverage-view="{{ item.id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}" aria-label="Show {{ item.label }} view" aria-controls="measurement-coverage-results">
        <span class="measurement-coverage__overview-label">{{ item.label }}</span>
        <span class="measurement-coverage__overview-counts"><strong>{{ item.mapped }}</strong> mapped · <strong>{{ item.verified }}</strong> verified · <strong>{{ item.gaps }}</strong> gaps</span>
      </button>
      {% endfor %}
    </div>
  </section>

  <section class="measurement-coverage__reading-key" aria-labelledby="coverage-key-title">
    <h2 id="coverage-key-title">Status key</h2>
    <div class="measurement-coverage__status-key" aria-label="Measurement evidence status key">
      {% for name, definition in payload.state_definitions.items() %}<span class="measurement-coverage__badge" data-state="{{ name|lower }}" title="{{ definition }}">{{ name }}</span>{% endfor %}
    </div>
    <details class="measurement-coverage__how-to-read"><summary>How to read this page</summary>
      <dl>{% for name, definition in payload.state_definitions.items() %}<div><dt>{{ name }}</dt><dd>{{ definition }}</dd></div>{% endfor %}</dl>
      <p><strong>Child-friendly explanation:</strong> Ready, switched on, used, and checked are different steps. DWARF shows each step.</p>
    </details>
    <details class="measurement-coverage__how-to-read"><summary>Client readiness status rules</summary>
      <dl>{% for name, definition in payload.client_readiness_definitions.items() %}<div><dt>{{ name }}</dt><dd>{{ definition }}</dd></div>{% endfor %}</dl>
      <p>A mapped scenario, configured collector, zero event count, or available tap alone is not Ready.</p>
    </details>
  </section>

  <section class="measurement-coverage__explorer" aria-labelledby="coverage-explorer-title">
    <span class="eyebrow">Current join · {{ payload.mapping_id }}</span>
    <h2 id="coverage-explorer-title">Explore applicability and evidence</h2>
    <div class="measurement-coverage__controls">
      <label>Search <input id="measurement-coverage-search" type="search" placeholder="Title, scenario, tap, or claim" autocomplete="off"></label>
      <label>Implementation <select id="measurement-coverage-implementation"><option value="">All implementations</option><option value="amaru">Amaru</option><option value="cardano-node">Cardano-node</option></select></label>
      <label>Source <select id="measurement-coverage-source"><option value="">All sources</option>{% for source in payload.sources %}<option value="{{ source|lower }}">{{ source }}</option>{% endfor %}</select></label>
      <label>Status <select id="measurement-coverage-status"><option value="">All statuses</option>{% for status in payload.statuses %}<option value="{{ status|lower }}">{{ status }}</option>{% endfor %}{% for status in payload.client_readiness_definitions %}<option value="{{ status|lower }}">{{ status }}</option>{% endfor %}</select></label>
      <button type="button" id="measurement-coverage-reset" aria-label="Clear search and filters">Clear</button>
    </div>
    <div class="measurement-coverage__result-line"><p id="measurement-coverage-result-status" role="status" aria-live="polite"></p></div>

    <div id="measurement-coverage-results">
      {% for section in view_sections %}
      <section class="measurement-coverage__view" data-coverage-panel="{{ section.id }}" aria-labelledby="view-title-{{ section.id }}"{% if not loop.first %} hidden{% endif %}>
        <h3 id="view-title-{{ section.id }}">{{ section.label }}</h3>
        <div class="measurement-coverage__rows"></div>
        <div class="measurement-coverage__row-templates">
          {% for row in section.rows %}<template class="measurement-coverage__row-template" data-search="{{ row.search_text }}" data-implementations="{{ (row.implementation_names if section.id == 'client_requirements' else row.implementations)|join(' ')|lower }}" data-sources="{{ row.sources|join(' ')|lower }}" data-status="{{ row.status|lower }}">{% if section.id == 'client_requirements' %}{{ client_requirement_card(row) }}{% else %}{{ result_card(row, section) }}{% endif %}</template>{% endfor %}
        </div>
      </section>
      {% endfor %}
    </div>
    <p id="measurement-coverage-empty" hidden>No entries match these filters.</p>
    <button type="button" id="measurement-coverage-show-more" aria-controls="measurement-coverage-results">Show 10 more</button>
    <p><strong>Child-friendly explanation:</strong> Pick a shelf, then narrow the cards. Open one card and then open only the detail that you need.</p>
  </section>

  <section class="measurement-coverage__boundary" aria-labelledby="coverage-boundary-title">
    <span class="eyebrow">Claim boundary</span>
    <h2 id="coverage-boundary-title">Known gaps stay visible</h2>
    <p><code>TM-030</code>, <code>TM-031</code>, and <code>RR-027</code> remain unavailable. Current repository evidence does not prove their required workload boundary. A catalog entry, configured collector, empty population, or zero value is not proof.</p>
    <p><strong>Child-friendly explanation:</strong> An empty notebook is not a passing test. DWARF says “not available” until it has real notes from the required test.</p>
  </section>
</div>
<script src="/static/js/measurement-coverage.js" defer></script>
{% endblock %}
