{% extends "_base.j2" %}
{% block main %}
<div class="measurement-coverage">
  <span class="eyebrow">Learn · Evidence-aware observability</span>
  <h1>Measurement coverage</h1>
  <p class="lede">This page joins the current threat model, risk register, scenario catalog, measurement definitions, profiles, and retained five-card evidence. It separates what a tap can measure from what a real workload has proved.</p>
  <p><a href="/learn/measurements">Measurement model</a> · <a href="/learn/coverage">Catalog coverage</a> · <a href="/learn/threat-coverage">Threat and risk map</a></p>
  <p><strong>Child-friendly explanation:</strong> A tool can fit a job without having been used. This page shows both the tools that fit and the saved tests that used them.</p>

  <hr class="hairline">
  <section aria-labelledby="coverage-state-title">
    <span class="eyebrow">Evidence states</span>
    <h2 id="coverage-state-title">Read each status as a separate claim</h2>
    <div class="measurement-coverage__state-grid">
      {% for name, definition in payload.state_definitions.items() %}
      <article><h3>{{ name }}</h3><p>{{ definition }}</p></article>
      {% endfor %}
    </div>
    <p><strong>Child-friendly explanation:</strong> “Ready,” “switched on,” “used,” and “checked” are four different steps. DWARF does not skip a step.</p>
  </section>

  <hr class="hairline">
  <section aria-labelledby="coverage-explorer-title">
    <span class="eyebrow">Current join · {{ payload.mapping_id }}</span>
    <h2 id="coverage-explorer-title">Explore applicability and evidence</h2>
    <div class="measurement-coverage__controls">
      <label>Search <input id="measurement-coverage-search" type="search" placeholder="ID, title, scenario, tap, or claim" autocomplete="off"></label>
      <label>Implementation <select id="measurement-coverage-implementation"><option value="">All implementations</option><option value="amaru">Amaru</option><option value="cardano-node">Cardano-node</option></select></label>
      <label>Source <select id="measurement-coverage-source"><option value="">All sources</option>{% for source in payload.sources %}<option value="{{ source|lower }}">{{ source }}</option>{% endfor %}</select></label>
      <label>Status <select id="measurement-coverage-status"><option value="">All statuses</option>{% for status in payload.statuses %}<option value="{{ status|lower }}">{{ status }}</option>{% endfor %}</select></label>
    </div>
    <fieldset class="measurement-coverage__views">
      <legend>View coverage by</legend>
      {% for section in view_sections %}<button type="button" data-coverage-view="{{ section.id }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ section.label }}</button>{% endfor %}
    </fieldset>
    <p id="measurement-coverage-result-status" role="status" aria-live="polite"></p>

    {% for section in view_sections %}
    <div class="measurement-coverage__view" data-coverage-panel="{{ section.id }}"{% if not loop.first %} hidden{% endif %}>
      <h3>{{ section.label }}</h3>
      <div class="measurement-coverage__rows">
        {% for row in section.rows %}
        <article class="measurement-coverage__row" data-search="{{ row.search_text }}" data-implementations="{{ row.implementations|join(' ')|lower }}" data-sources="{{ row.sources|join(' ')|lower }}" data-status="{{ row.status|lower }}">
          <header>
            <div><span class="eyebrow">{{ row.id }}</span><h4>{{ row.title }}</h4></div>
            <span class="measurement-coverage__status" data-state="{{ row.status|lower }}">{{ row.status }}</span>
          </header>
          <p>{{ row.description }}</p>
          <dl class="measurement-coverage__summary">
            <div><dt>Implementation</dt><dd>{{ row.implementations|join(', ') }}</dd></div>
            <div><dt>Scenario families</dt><dd>{{ row.scenario_families|join(', ') if row.scenario_families else 'No mapped scenario family' }}</dd></div>
            <div><dt>Mapped scenarios</dt><dd>{{ row.scenario_count }}</dd></div>
            <div><dt>Sources</dt><dd>{% for source in row.sources %}<span class="measurement-coverage__source" data-source="{{ source|lower }}">{{ source }}</span>{% endfor %}</dd></div>
          </dl>
          <details>
            <summary>Technical detail</summary>
            <div class="measurement-coverage__detail">
              <h5>Applicable taps</h5>
              <ul>{% for tap in row.measurements %}<li><a href="{{ tap.url }}"><code>{{ tap.id }}</code></a> — {{ tap.source }} · {{ tap.status }}</li>{% endfor %}</ul>
              <h5>Required workload or event</h5><p>{{ row.prerequisite }}</p>
              <h5>Mapped scenarios</h5>
              {% if row.scenarios %}<ul>{% for scenario in row.scenarios %}<li><a href="{{ scenario.url }}"><code>{{ scenario.id }}</code></a> — {{ scenario.title }}</li>{% endfor %}</ul>{% else %}<p>No current scenario maps to this entry.</p>{% endif %}
              <h5>Retained evidence</h5>
              {% if row.evidence %}<ul>{% for item in row.evidence %}<li><a href="{{ item.url }}"><code>{{ item.run_id }}</code></a> — Card {{ item.card_id }}, {{ item.implementation }}, <code>{{ item.measurement_id }}</code></li>{% endfor %}</ul>{% else %}<p>No retained non-vacuous five-card measurement evidence maps to this entry.</p>{% endif %}
              <h5>What it can prove</h5><p>{{ row.can_prove }}</p>
              <h5>Explicit non-claims</h5><p>{{ row.non_claims }}</p>
            </div>
          </details>
        </article>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
    <p id="measurement-coverage-empty" hidden>No entries match these filters.</p>
    <p><strong>Child-friendly explanation:</strong> Pick a shelf, then narrow the cards. Open a card to see which real recipe, ruler, and saved result support it.</p>
  </section>

  <hr class="hairline">
  <section aria-labelledby="coverage-boundary-title">
    <span class="eyebrow">Claim boundary</span>
    <h2 id="coverage-boundary-title">Known gaps stay visible</h2>
    <p><code>TM-030</code>, <code>TM-031</code>, and <code>RR-027</code> remain unavailable because the current repository evidence does not prove their required workload boundary. A catalog entry, configured collector, empty population, or zero value is not proof.</p>
    <p><strong>Child-friendly explanation:</strong> An empty notebook is not a passing test. DWARF says “not available” until it has real notes from the required test.</p>
  </section>
</div>
<script src="/static/js/measurement-coverage.js" defer></script>
{% endblock %}
