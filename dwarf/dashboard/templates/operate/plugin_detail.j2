{% extends "_base.j2" %}
{% block main %}
<p class="breadcrumb"><a href="/operate/plugins">Plugins</a> <span>/</span> <code>{{ plugin.plugin_id }}</code></p>
<header class="definition-header"><div><span class="eyebrow">{{ plugin.status }} · {{ plugin.load_mode }}</span><h1>{{ plugin.plugin_id }}</h1><p class="page-hero">{{ plugin.description or 'No description is declared in the manifest.' }}</p></div><div class="definition-actions"><a class="cta cta--ghost" href="/api/plugins/{{ plugin.catalog_id }}/export" download>Export catalog sources</a><a class="cta cta--ghost" href="/learn/plugin-authoring" target="_blank" rel="noopener">Authoring and trust model</a><a class="cta cta--ghost" href="/operate/primitives">Primitive catalog</a></div></header>
<section class="asset-diagnostics"><strong>Trust boundary</strong><p>{{ plugin.trust_warning }}</p></section>
<dl class="definition-summary"><div><dt>Plugin ID</dt><dd><code>{{ plugin.plugin_id }}</code></dd></div><div><dt>Status</dt><dd>{{ plugin.status }}</dd></div><div><dt>Load mode</dt><dd>{{ plugin.load_mode }}</dd></div><div><dt>API version</dt><dd><code>{{ plugin.dwarf_api_version or 'missing' }}</code></dd></div><div><dt>Version</dt><dd><code>{{ plugin.version or 'undeclared' }}</code></dd></div><div><dt>Static primitives</dt><dd>{{ plugin.static_primitive_count }}</dd></div></dl>

{% if plugin.errors or plugin.warnings or plugin.discrepancies %}<section><span class="eyebrow">Diagnostics</span><h2>Validation and visibility</h2><div class="plugin-diagnostic-grid">
  {% if plugin.errors %}<article class="asset-diagnostics"><strong>Errors</strong><ul>{% for error in plugin.errors %}<li>{{ error }}</li>{% endfor %}</ul></article>{% endif %}
  {% if plugin.discrepancies %}<article class="asset-diagnostics"><strong>Discrepancies</strong><ul>{% for item in plugin.discrepancies %}<li>{{ item }}</li>{% endfor %}</ul></article>{% endif %}
  {% if plugin.warnings %}<article class="asset-diagnostics"><strong>Boundary notes</strong><ul>{% for warning in plugin.warnings %}<li>{{ warning }}</li>{% endfor %}</ul></article>{% endif %}
</div></section>{% endif %}

<section><span class="eyebrow">Source boundary</span><h2>Manifest and paths</h2><dl class="plugin-path-grid"><div><dt>Configured root</dt><dd><code>{{ plugin.configured_root }}</code></dd></div><div><dt>Plugin root</dt><dd><code>{{ plugin.plugin_root }}</code></dd></div><div><dt>Manifest</dt><dd><code>{{ plugin.manifest_path }}</code></dd></div><div><dt>Registry</dt><dd>{% if plugin.registry_path %}<code>{{ plugin.registry_path }}</code> · {{ 'present' if plugin.registry_exists else 'missing' }}{% else %}not declared{% endif %}</dd></div><div><dt>Entrypoint</dt><dd>{% if plugin.entrypoint_path %}<code>{{ plugin.entrypoint_path }}</code> · {{ 'present' if plugin.entrypoint_exists else 'missing' }}{% else %}not declared{% endif %}</dd></div></dl></section>

<section><span class="eyebrow">Declarative surface</span><h2>Static primitive reconciliation</h2><p>A registry-only plugin avoids a new registration entrypoint, but every declared primitive still needs a valid module/class executor. A mixed or entrypoint-only plugin may add more primitives at runtime; runtime registration cannot be safely inventoried here because doing so would execute plugin code.</p>
{% if plugin.primitives %}<div class="plugin-primitive-list">{% for primitive in plugin.primitives %}<article class="plugin-primitive"><span class="eyebrow">{{ primitive.status }}{% if primitive.family %} · {{ primitive.family }}{% endif %}</span><h3>{% if primitive.url and primitive.resolved %}<a href="{{ primitive.url }}"><code>{{ primitive.id }}</code></a>{% else %}<code>{{ primitive.id }}</code> <span class="pill">unresolved</span>{% endif %}</h3><p><code>{{ primitive.module or 'module missing' }}.{{ primitive.class_name or 'class missing' }}</code></p>{% if primitive.errors %}<ul>{% for error in primitive.errors %}<li>{{ error }}</li>{% endfor %}</ul>{% endif %}</article>{% endfor %}</div>{% else %}<p class="empty-section-statement">No statically knowable primitive declarations. {% if plugin.runtime_contributions_unknown %}The entrypoint may register runtime contributions, but this read-only view does not execute it.{% endif %}</p>{% endif %}</section>

<section><span class="eyebrow">Exact metadata</span><h2>Manifest source</h2>{% if plugin.manifest_source %}<pre class="asset-source plugin-manifest-source"><code>{{ plugin.manifest_source|tojson(indent=2) }}</code></pre>{% else %}<p class="empty-section-statement">No parseable manifest source is available.</p>{% endif %}</section>
{% endblock %}
