{% extends "_base.j2" %}
{% block main %}
<span class="eyebrow">Operate</span>
<h1>Forensic substrate</h1>
<p class="lede">Adversarial inputs against Amaru and the Haskell Cardano node, recorded as tamper-evident evidence bundles. The substrate is observed, probed, and replayed under fault.</p>

<hr class="hairline">


{# ---- BASIC view: operator-first summary (Advanced shows the full grid) ---- #}
<section class="basic-only dk" aria-label="The deck box">
  {% set total = (pass_count or 0) + (fail_count or 0) + (other_count or 0) %}
  <h2 class="dk-lead" style="margin-top:0">{% if runs_total %}{{ pass_rate_pct }}% of the last {{ runs_total }} runs passed — {{ bundles_count }} evidence bundles are preserved.{% else %}No runs yet — start one to deal the first card.{% endif %}</h2>
  <p class="dk-plain"><b>A count is not a verdict.</b> {{ fail_count }} failed and {{ other_count }} ended in error. Catalog stacks below are inventory, not coverage or security assurance — open a run to check what it asserted and whether its hash chain verifies.</p>
  <div class="dk-box">
    <div>
      {% set C = 502.65 %}
      <svg class="dk-dial" viewBox="0 0 200 200" role="img" aria-label="{{ pass_count }} pass, {{ fail_count }} fail, {{ other_count }} error of {{ runs_total }} runs">
        <circle cx="100" cy="100" r="80" fill="none" stroke="rgba(255,255,255,.08)" stroke-width="16"/>
        {% if total %}
        {% set p = C * pass_count / total %}{% set f = C * fail_count / total %}{% set o = C * other_count / total %}
        <circle cx="100" cy="100" r="80" fill="none" stroke="var(--dk-pass)" stroke-width="16" stroke-dasharray="{{ p }} {{ C }}" transform="rotate(-90 100 100)"/>
        <circle cx="100" cy="100" r="80" fill="none" stroke="var(--dk-fail)" stroke-width="16" stroke-dasharray="{{ f }} {{ C }}" stroke-dashoffset="{{ -p }}" transform="rotate(-90 100 100)"/>
        <circle cx="100" cy="100" r="80" fill="none" stroke="var(--dk-err)" stroke-width="16" stroke-dasharray="{{ o }} {{ C }}" stroke-dashoffset="{{ -(p + f) }}" transform="rotate(-90 100 100)"/>
        {% endif %}
        <circle cx="100" cy="100" r="62" fill="none" stroke="rgba(230,198,127,.35)" stroke-width="1"/>
        <text x="100" y="98" text-anchor="middle" fill="var(--dk-ink)" style="font:600 36px var(--dk-serif)">{{ pass_rate_pct if pass_rate_pct is not none else '—' }}{% if pass_rate_pct is not none %}%{% endif %}</text>
        <text x="100" y="122" text-anchor="middle" fill="var(--dk-muted)" style="font:10px var(--dk-mono);letter-spacing:.14em">PASS · LAST {{ runs_window }}</text>
      </svg>
      <div class="dk-dial-legend"><span class="dk-g-pass">♦ {{ pass_count }} pass</span><span class="dk-g-fail">▲ {{ fail_count }} fail</span><span class="dk-g-error">✕ {{ other_count }} error</span></div>
    </div>
    <div>
      <p class="eyebrow" style="margin:0 0 14px">Catalog · card backs (inventory, not proof)</p>
      <div class="dk-stacks">
        {% for label, count, href in [
          ('Scenarios', scenario_count, '/operate/scenarios'), ('Primitives', primitive_count, '/operate/primitives'),
          ('Targets', target_count, '/operate/targets'), ('Profiles', profile_count, '/operate/profiles'),
          ('Evidence bundles', bundles_count, '/operate/bundles'), ('Corpus inputs', corpus_input_count, '/operate/corpora'),
          ('Grammar tokens', grammar_token_count, '/operate/grammars'), ('Measurement taps', measurement_count, '/operate/measurements'),
          ('Risk candidates', risk_candidate_count, '/operate/risk-packages'), ('Profile templates', profile_template_count, '/operate/profile-templates')] %}
        {% if count is not none and count is defined %}
        {% set n = [((count|string)|length) + 1, 6]|min %}
        <a class="dk-stack" href="{{ href }}?view=advanced" style="--n:{{ n }}">
          <span class="dk-stack__pile" aria-hidden="true">{% for k in range(n) %}<i style="--k:{{ k }}"></i>{% endfor %}</span>
          <b>{{ count }}</b><small>{{ label }}</small></a>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="dk-loop">
    <a class="dk-card" href="/run"><div class="dk-face"><div class="dk-face__body">
      <div class="dk-kicker"><span>01</span><span>♦</span></div><div class="dk-title">Start a run</div>
      <p class="dk-sub">Pick a scenario and profile; DWARF checks versions and readiness first.</p></div></div></a>
    <a class="dk-card" href="/operate/runs"><div class="dk-face"><div class="dk-face__body">
      <div class="dk-kicker"><span>02</span><span>♦</span></div><div class="dk-title">Inspect results</div>
      <p class="dk-sub">Open a run for its verdict, asserted property and hash-chain integrity.</p></div></div></a>
    <a class="dk-card" href="/operate/bundles"><div class="dk-face"><div class="dk-face__body">
      <div class="dk-kicker"><span>03</span><span>♦</span></div><div class="dk-title">Export evidence</div>
      <p class="dk-sub">Download the portable, hash-chained bundle for audit and replay.</p></div></div></a>
  </div>

  <h2 class="b-h2">What is proven vs mapped
    <a class="b-adv-link" href="?view=advanced">Open the full substrate in Advanced &rarr;</a></h2>
  <div class="b-chips">
    <a class="b-chip" href="/learn/threat-coverage">Threat &amp; risk binder</a>
    <a class="b-chip" href="/learn/measurement-coverage">Measurement coverage</a>
    <a class="b-chip" href="/operate/status">Substrate health</a>
    <a class="b-chip" href="/operate/versions?view=advanced">Node versions</a>
  </div>
</section>

<section class="landing-section adv-only" id="recent-activity">
  <span class="eyebrow">Recent activity</span>
  <div class="tile-grid">

    <a class="tile tile--data" href="/operate/runs">
      <span class="tile__eyebrow">Recent runs · last {{ runs_window }}</span>
      <span class="tile__metric">{{ runs_total }}</span>
      <span class="tile__sub">
        <span class="tile__sub-pass">{{ pass_count }} pass</span>
        <span class="tile__sub-sep">·</span>
        <span class="tile__sub-fail">{{ fail_count }} fail</span>
        {% if other_count %}
        <span class="tile__sub-sep">·</span>
        <span class="tile__sub-muted">{{ other_count }} other</span>
        {% endif %}
      </span>
      {% if pass_rate_pct is not none %}
      <span class="tile__bar" aria-label="pass rate {{ pass_rate_pct }}%">
        <span class="tile__bar-fill" style="width: {{ pass_rate_pct }}%"></span>
      </span>
      <span class="tile__bar-caption">{{ pass_rate_pct }}% pass-rate</span>
      {% endif %}
    </a>

    <a class="tile tile--data" href="/operate/bundles">
      <span class="tile__eyebrow">Bundles preserved</span>
      <span class="tile__metric">{{ bundles_count }}</span>
      <span class="tile__sub">
        {% if bundles_count %}
          preserved across runs
        {% else %}
          none preserved yet
        {% endif %}
      </span>
    </a>

    <a class="tile tile--data" href="/operate/compare">
      <span class="tile__eyebrow">Cross-impl comparisons</span>
      <span class="tile__metric">{{ comparisons_count }}</span>
      <span class="tile__sub">
        {% if comparisons_count %}
          {{ divergent_count }} divergent
        {% else %}
          no comparisons yet
        {% endif %}
      </span>
    </a>

  </div>
</section>

<section class="landing-section adv-only" id="substrate">
  <span class="eyebrow">Substrate</span>
  <div class="tile-grid">

    <a class="tile" href="/operate/scenarios">
      <span class="tile__eyebrow">Scenario catalog</span>
      <span class="tile__metric">{{ scenario_count }}</span>
      <span class="tile__sub">scenarios available to replay</span>
    </a>

    <a class="tile" href="/operate/primitives">
      <span class="tile__eyebrow">Primitive catalog</span>
      <span class="tile__metric">{{ primitive_count }}</span>
      <span class="tile__sub">typed operations available to scenarios</span>
    </a>

    <a class="tile" href="/operate/antithesis">
      <span class="tile__eyebrow">Antithesis campaigns</span>
      <span class="tile__metric tile__metric--label">build · validate · launch</span>
      <span class="tile__sub">scenario → hermetic bundle → Moog launch</span>
    </a>

    <a class="tile" href="/operate/targets">
      <span class="tile__eyebrow">Registered targets</span>
      <span class="tile__metric">{{ target_count }}</span>
      <span class="tile__sub">
        {% for pill in target_pills %}{% if not loop.first %} <span class="tile__sub-sep">·</span> {% endif %}<code>{{ pill.label }}</code> {{ pill.count }}{% endfor %}
      </span>
    </a>

    <a class="tile" href="/operate/profiles">
      <span class="tile__eyebrow">Profile · {{ profile_count }} configured</span>
      <span class="tile__metric tile__metric--code">
        {% if profile_id %}<code>{{ profile_id }}</code>{% else %}<span class="tile__metric-empty">no profile</span>{% endif %}
      </span>
      <span class="tile__sub">active local devnet profile</span>
    </a>

    <a class="tile" href="/operate/versions">
      <span class="tile__eyebrow">Node versions</span>
      <span class="tile__metric tile__metric--label">evidence-backed defaults</span>
      <span class="tile__sub">Cardano-node {{ version_defaults.cardano }} · Amaru {{ version_defaults.amaru }} · Mixed {{ version_defaults.mixed_cardano }} + {{ version_defaults.mixed_amaru }}</span>
    </a>

    <article class="tile tile--data" data-measurements-hub>
      <span class="tile__eyebrow">Measurements</span>
      <span class="tile__metric">{{ measurement_count }} <small>taps</small> · {{ measurement_profile_count }} <small>profiles</small></span>
      <span class="tile__sub">Profiles select taps; run reports contain results.</span>
      <span class="tile__sub">
        <a href="/operate/measurements">Definitions</a> ·
        <a href="/operate/measurement-profiles">Profiles</a> ·
        <a href="/operate/runs">Run results</a>
      </span>
    </article>

    <a class="tile" href="/operate/profile-templates">
      <span class="tile__eyebrow">Profile templates</span>
      <span class="tile__metric">{{ profile_template_count }}</span>
      <span class="tile__sub">read-only topology scaffolds</span>
    </a>

    <a class="tile" href="/operate/corpora">
      <span class="tile__eyebrow">Fuzz corpora · {{ corpus_count }} units</span>
      <span class="tile__metric">{{ corpus_input_count }}</span>
      <span class="tile__sub">exact retained inputs · browse + safe runtime management</span>
    </a>

    <a class="tile" href="/operate/grammars">
      <span class="tile__eyebrow">Generation grammars · {{ grammar_count }} sets</span>
      <span class="tile__metric">{{ grammar_token_count }}</span>
      <span class="tile__sub">validated structures + finite mutation tokens</span>
    </a>

    <a class="tile" href="/operate/risk-packages">
      <span class="tile__eyebrow">Risk work packages · {{ risk_package_count }} groups</span>
      <span class="tile__metric">{{ risk_candidate_count }}</span>
      <span class="tile__sub">candidate-risk IDs · planning, evidence references + blockers</span>
    </a>

    <a class="tile" href="/operate/status">
      <span class="tile__eyebrow">Substrate status</span>
      <span class="tile__metric tile__metric--label">deployment health</span>
      <span class="tile__sub">live + cached health</span>
    </a>

    <a class="tile" href="/operate/coverage">
      <span class="tile__eyebrow">Coverage roll-up</span>
      <span class="tile__metric tile__metric--label">latest report</span>
      <span class="tile__sub">cross-bundle aggregate</span>
    </a>

    <a class="tile" href="/operate/crashes">
      <span class="tile__eyebrow">Crash triage</span>
      <span class="tile__metric tile__metric--label">deduped signatures</span>
      <span class="tile__sub">grouped by signal + op</span>
    </a>

    <a class="tile" href="/operate/schedule">
      <span class="tile__eyebrow">Schedule</span>
      <span class="tile__metric tile__metric--label">cron-driven runs</span>
      <span class="tile__sub">queued + paused entries</span>
    </a>

    <a class="tile" href="/operate/timeline">
      <span class="tile__eyebrow">Evidence timeline</span>
      <span class="tile__metric tile__metric--label">chronology</span>
      <span class="tile__sub">cross-bundle event stream</span>
    </a>

    <a class="tile" href="/operate/static-analysis">
      <span class="tile__eyebrow">Static analysis</span>
      <span class="tile__metric tile__metric--label">clippy · audit · deny</span>
      <span class="tile__sub">latest per-tool run</span>
    </a>

  </div>
</section>

<section class="landing-section adv-only" id="tools">
  <span class="eyebrow">Tools</span>
  <div class="tile-grid">

    <a class="tile" href="/operate/plugins">
      <span class="tile__eyebrow">Plugins</span>
      <span class="tile__metric tile__metric--label">registry</span>
      <span class="tile__sub">discovered plugins + primitives</span>
    </a>

    <a class="tile" href="/operate/config">
      <span class="tile__eyebrow">Config</span>
      <span class="tile__metric tile__metric--label">read-only</span>
      <span class="tile__sub">resolved against defaults + env</span>
    </a>

    <a class="tile" href="/operate/notifications">
      <span class="tile__eyebrow">Notifications</span>
      <span class="tile__metric tile__metric--label">webhooks · slack · email</span>
      <span class="tile__sub">configured rules per event</span>
    </a>

    <a class="tile" href="/operate/bundles">
      <span class="tile__eyebrow">Bundles</span>
      <span class="tile__metric tile__metric--label">preserved evidence</span>
      <span class="tile__sub">browse + import</span>
    </a>

  </div>
</section>
{% endblock %}
