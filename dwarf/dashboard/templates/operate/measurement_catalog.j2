{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_deck.j2" import deck_head, deck_grid, deck_more with context %}
{% if ui == "basic" %}
{% set n = rows|length %}
{% if catalog == 'measurements' %}
{% set n_def = rows|selectattr('default_enabled')|list|length %}
{% set lead = (n ~ ' measurement tap' ~ ('' if n == 1 else 's') ~ ' defined — ' ~ n_def ~ ' on by default, ' ~ (n - n_def) ~ ' optional.') if not empty else 'No measurement taps are defined yet.' %}
{% set plain = 'A tap is a definition of what DWARF can observe during a run. Being listed here means it can be collected, not that it has been.' %}
{% else %}
{% set lead = (n ~ ' measurement profile' ~ ('' if n == 1 else 's') ~ ' — reusable selections of taps for a run.') if not empty else 'No measurement profiles are defined yet.' %}
{% set plain = 'A measurement profile only selects which taps to collect. It is configuration, not evidence.' %}
{% endif %}
{% call deck_head('Operate · ' ~ eyebrow, lead, plain) %}<p><a class="dk-btn" href="{{ other_url }}">{{ other_label }} →</a></p>{% endcall %}
{% endif %}
<div class="adv-only">
<div class="scenarios-header">
  <div>
    <span class="eyebrow">Operate · {{ eyebrow }}</span>
    <h1>{{ heading }}</h1>
  </div>
  <div class="definition-actions">
    <a class="cta cta--ghost" href="{{ other_url }}">{{ other_label }}</a>
    <a class="cta cta--ghost" href="/api/catalog/{{ catalog }}/export" download>Download all</a>
    <a class="cta" href="/operate/{{ catalog }}/new">{{ create_label }}</a>
  </div>
</div>
<p>{{ description }}</p>

<hr class="hairline">

<label class="profile-catalog__search">Search {{ heading|lower }}
  <input type="search" data-measurement-filter placeholder="ID, title, implementation, mode…">
</label>

{% if empty %}
<p class="empty-section-statement">No {{ heading|lower }} found.</p>
{% else %}
<div class="version-catalog" data-measurement-list>
  {% for row in rows %}
  <article class="version-card" data-measurement-search="{{ row.search }}">
    <div class="version-card__head">
      <div>
        <span class="eyebrow">{{ row.implementation }}</span>
        <h2>{{ row.title }}</h2>
        <code>{{ row.id }}</code>
      </div>
      {% if catalog == 'measurements' %}
      <span class="version-badge version-badge--{{ 'confirmed' if row.default_enabled else 'unknown' }}">{{ 'default' if row.default_enabled else 'optional' }}</span>
      {% else %}
      <span class="version-badge version-badge--confirmed">{{ row.measurement_count }} taps</span>
      {% endif %}
    </div>
    {% if row.description %}<p>{{ row.description }}</p>{% endif %}
    <dl>
      {% if row.collection_mode %}<div><dt>collection</dt><dd><code>{{ row.collection_mode }}</code></dd></div>{% endif %}
      {% if row.overhead_class %}<div><dt>overhead</dt><dd><code>{{ row.overhead_class }}</code></dd></div>{% endif %}
      <div><dt>target modes</dt><dd>{% for mode in row.modes %}<code>{{ mode }}</code>{% if not loop.last %} · {% endif %}{% else %}—{% endfor %}</dd></div>
    </dl>
    <div class="definition-actions">
      <a class="cta cta--primary" href="/operate/{{ catalog }}/{{ row.id }}">View</a>
      <a class="cta cta--ghost" href="/operate/{{ catalog }}/{{ row.id }}/edit">Edit</a>
      <a class="cta cta--ghost" href="/api/catalog/{{ catalog }}/{{ row.id }}/download" download>Download</a>
    </div>
  </article>
  {% endfor %}
</div>
{% endif %}
</div>
{% if ui == "basic" %}
{% set cards = [] %}{% set impls = [] %}
{% for row in rows %}
{% if row.implementation not in impls %}{% set _ = impls.append(row.implementation) %}{% endif %}
{% set facts = [] %}
{% if row.collection_mode %}{% set _ = facts.append(('Collection', row.collection_mode)) %}{% endif %}
{% if row.overhead_class %}{% set _ = facts.append(('Overhead', row.overhead_class)) %}{% endif %}
{% if catalog != 'measurements' %}{% set _ = facts.append(('Taps', row.measurement_count)) %}{% endif %}
{% set _ = cards.append({
  'title': row.title, 'id': row.id, 'href': '/operate/' ~ catalog ~ '/' ~ row.id,
  'kicker': row.implementation ~ (' · ' ~ ('default' if row.default_enabled else 'optional') if catalog == 'measurements' else ''),
  'sub': row.description, 'tier': 'back', 'group': row.implementation, 'facts': facts,
  'tags': row.modes or [], 'search': row.search}) %}
{% endfor %}
{% set groups = [] %}{% for i in impls|sort %}{% set _ = groups.append((i, i ~ ' · ' ~ rows|selectattr('implementation', 'equalto', i)|list|length)) %}{% endfor %}
<h2 class="b-h2 basic-only">Catalog · card backs (defined, not collected)</h2>
{{ deck_grid(cards, label=heading|lower, groups=groups, empty='No ' ~ heading|lower ~ ' found.') }}
{{ deck_more(create_label ~ ', edit and download in Advanced') }}
{% endif %}

<script>
var measurementFilter=document.querySelector('[data-measurement-filter]');
if(measurementFilter){measurementFilter.addEventListener('input',function(){var q=this.value.trim().toLowerCase();document.querySelectorAll('[data-measurement-search]').forEach(function(row){row.hidden=Boolean(q&&!row.dataset.measurementSearch.includes(q));});});}
</script>
{% endblock %}
