{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_deck.j2" import deck_head with context %}
{% call deck_head('Start run · ' ~ (wizard.scenarios|length) ~ ' scenarios', 'Pick a scenario, let DWARF check it, then start one real local run.', 'Work down the cards in order. Start stays disabled until DWARF resolves a valid plan and every required check is ready; pressing it launches the run, streams output here, and files the result in the normal evidence viewer.') %}{% endcall %}
<section id="run-wizard" class="run-wizard" data-resolve-url="/api/run/resolve" data-start-url="/api/run/start" data-dashboard-token="{{ token }}">
  <span class="eyebrow adv-only">Local real-node execution</span>
  <h1 class="adv-only">Start a DWARF run</h1>
  <p class="page-hero adv-only">Choose a scenario. DWARF checks the profile, exact node versions, measurements, primitives, and required runtime before it can start.</p>
  <p class="run-wizard__plain adv-only"><strong>Plain meaning:</strong> Choose the test. DWARF fills in the safe defaults and tells you what must be ready.</p>

  <nav class="run-wizard__progress" aria-label="Run stages"><ol>
    {% for key, label in [('scenario', 'Scenario'), ('target', 'Target'), ('profile', 'Profile'), ('versions', 'Versions'), ('measurements', 'Measurements'), ('primitives', 'Primitives'), ('settings', 'Settings'), ('readiness', 'Readiness'), ('review', 'Review'), ('launch', 'Run')] %}
    <li><a href="#run-stage-{{ key }}" data-run-progress="{{ key }}"{% if loop.first %} aria-current="step"{% endif %}><span>{{ loop.index }}</span>{{ label }}</a></li>
    {% endfor %}
  </ol></nav>

  <form data-run-wizard-form novalidate><div class="run-wizard__layout">
    <section id="run-stage-scenario" class="run-wizard__step" data-run-step="scenario" aria-labelledby="run-step-scenario">
      <header><span>01</span><div><h2 id="run-step-scenario">Scenario</h2><small>Required</small></div></header>
      <p class="adv-only">Select the test recipe. This choice controls all later options.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> Pick what DWARF will do.</p>
      <label for="run-scenario-search">Find a scenario <span class="field-optional">Optional</span></label>
      <input id="run-scenario-search" type="search" autocomplete="off" placeholder="Search by purpose, implementation, or exact ID">
      <div class="scenario-picker__filters" role="group" aria-label="Filter scenarios">
        {% for key, label in [('all', 'All'), ('recommended', 'Recommended'), ('amaru', 'Amaru'), ('cardano-node', 'Cardano-node'), ('mixed', 'Mixed'), ('other', 'Other')] %}<button type="button" data-scenario-filter="{{ key }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ label }}</button>{% endfor %}
      </div>
      <label id="run-scenario-picker-label" for="run-scenario">Scenario <span class="field-required">Required</span></label>
      <select id="run-scenario" name="scenario_id" required class="run-wizard__canonical-select" tabindex="-1" aria-hidden="true">
        {% for scenario in wizard.scenarios %}<option value="{{ scenario.id }}"{% if scenario.id == wizard.default_scenario_id %} selected{% endif %}>{{ scenario.short_title }}</option>{% endfor %}
      </select>
      <div class="scenario-picker" data-scenario-picker role="listbox" aria-labelledby="run-scenario-picker-label" tabindex="0">
        {% for scenario in wizard.scenarios %}
        {% set visual_class = 'cardano' if scenario.implementation_key == 'cardano-node' else scenario.implementation_key if scenario.implementation_key in ['amaru', 'mixed'] else 'neutral' %}
        <button type="button" role="option" class="scenario-picker__option scenario-picker__option--{{ visual_class }}" data-scenario-id="{{ scenario.id }}" data-scenario-group="{{ scenario.filter_group }}" data-recommended="{{ 'true' if scenario.recommended_demo else 'false' }}" data-search="{{ scenario.short_title }} {{ scenario.id }} {{ scenario.implementation }} {{ scenario.measurement_state }} {{ scenario.proof_state }}" aria-selected="{{ 'true' if scenario.id == wizard.default_scenario_id else 'false' }}">
          <span class="scenario-picker__title">{{ scenario.short_title }}</span>
          <span class="scenario-picker__badges"><span class="scenario-picker__badge scenario-picker__badge--implementation">{{ scenario.implementation }}</span>{% if scenario.measurement_state == 'measurement-enabled' %}<span class="scenario-picker__badge">Measurement-enabled</span>{% endif %}{% if scenario.proof_state == 'retained-proof' %}<span class="scenario-picker__badge scenario-picker__badge--proof">✓ Measurement proof</span>{% elif scenario.proof_state == 'supported-without-retained-proof' %}<span class="scenario-picker__badge scenario-picker__badge--supported">◐ Supported · no retained proof</span>{% else %}<span class="scenario-picker__badge scenario-picker__badge--neutral">○ Unconfirmed / unsupported</span>{% endif %}{% if scenario.recommended_demo %}<span class="scenario-picker__badge scenario-picker__badge--recommended">Recommended demo</span>{% endif %}</span>
          <code class="scenario-picker__id">{{ scenario.id }}</code>
        </button>
        {% endfor %}
      </div>
      <p class="scenario-picker__count" data-scenario-picker-count aria-live="polite"></p>
      <article class="scenario-selection" data-scenario-summary aria-live="polite">
        <h3 data-scenario-summary-title>Selected scenario</h3>
        <dl class="run-wizard__facts" data-scenario-summary-facts></dl>
        <p data-scenario-summary-purpose></p>
        <p data-scenario-summary-limit></p>
        <p data-scenario-summary-evidence></p>
        <details><summary>Technical scenario ID</summary><code data-scenario-raw-id></code></details>
      </article>
    </section>

    <section id="run-stage-target" class="run-wizard__step" data-run-step="target" aria-labelledby="run-step-target">
      <header><span>02</span><div><h2 id="run-step-target">Target and runtime</h2><small>Derived</small></div></header>
      <p class="adv-only">DWARF derives the real implementation and execution runtime from the scenario.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> This shows which real node the test touches and where it runs.</p>
      <dl class="run-wizard__facts" data-run-summary="target"><div><dt>Target</dt><dd>Resolving…</dd></div></dl>
    </section>

    <section id="run-stage-profile" class="run-wizard__step" data-run-step="profile" aria-labelledby="run-step-profile">
      <header><span>03</span><div><h2 id="run-step-profile">Profile</h2><small>Conditional</small></div></header>
      <p class="adv-only">A profile defines the real-node deployment shape. Library and attached-topology scenarios do not need one.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> This is the group of nodes the test uses.</p>
      <label for="run-profile">Deployment profile <span class="field-optional">Optional override</span></label>
      <select id="run-profile" name="profile_id"><option value="">Scenario default</option>{% for profile in wizard.profiles %}<option value="{{ profile.id }}">{{ profile.label }} · {{ profile.haskell_count }} Cardano / {{ profile.amaru_count }} Amaru</option>{% endfor %}</select>
      <div class="run-wizard__selection" data-run-summary="profile">Scenario default</div>
    </section>

    <section id="run-stage-versions" class="run-wizard__step" data-run-step="versions" aria-labelledby="run-step-versions">
      <header><span>04</span><div><h2 id="run-step-versions">Node versions</h2><small>Default selected</small></div></header>
      <p class="adv-only"><code>latest-confirmed</code> is the normal default. Exact versions remain available when the profile supports them.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> Use the newest node versions that DWARF has proved work, unless you choose another one.</p>
      <label for="run-version-policy">Version policy</label>
      <select id="run-version-policy" name="version_policy"><option value="">Profile default</option>{% for policy in wizard.version_policies %}<option value="{{ policy }}">{{ policy }}</option>{% endfor %}</select>
      <div class="run-wizard__version-grid">
        <label for="run-cardano-version">Cardano-node version <span class="field-optional">Exact only</span><input id="run-cardano-version" name="cardano_version" autocomplete="off"></label>
        <label for="run-amaru-version">Amaru version <span class="field-optional">Exact only</span><input id="run-amaru-version" name="amaru_version" autocomplete="off"></label>
      </div>
      <label class="run-wizard__check"><input type="checkbox" name="acknowledge_unknown_versions"> Allow this one run to use a catalogued but unconfirmed version</label>
      <div class="run-wizard__selection" data-run-summary="versions">Resolving exact versions…</div>
    </section>

    <section id="run-stage-measurements" class="run-wizard__step" data-run-step="measurements" aria-labelledby="run-step-measurements">
      <header><span>05</span><div><h2 id="run-step-measurements">Measurements</h2><small>Optional override</small></div></header>
      <p>Measurements observe the run. They do not change scenario pass or fail unless a threshold gate is explicitly enabled.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> These are extra rulers and stopwatches.</p>
      <label for="run-measurements">Measurement profile</label>
      <select id="run-measurements" name="measurement_profile"><option value="">Scenario or compatible default</option><option value="none">No measurements</option>{% for profile in wizard.measurement_profiles %}<option value="{{ profile.id }}">{{ profile.title }} · {{ profile.measurement_count }} taps</option>{% endfor %}</select>
      <div data-run-summary="measurements" class="run-wizard__list"></div>
    </section>

    <section id="run-stage-primitives" class="run-wizard__step" data-run-step="primitives" aria-labelledby="run-step-primitives">
      <header><span>06</span><div><h2 id="run-step-primitives">Primitives</h2><small>Read-only</small></div></header>
      <p class="adv-only">Primitives are the scenario operations and assertions. Changing them creates a different scenario.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> These are the exact actions in the test.</p>
      <div data-run-summary="primitives" class="run-wizard__list"></div>
      <a href="/operate/scenarios/new" target="_blank" rel="noreferrer">Customize as a new scenario</a>
    </section>

    <section id="run-stage-settings" class="run-wizard__step" data-run-step="settings" aria-labelledby="run-step-settings">
      <header><span>07</span><div><h2 id="run-step-settings">Run settings</h2><small>Scenario controlled</small></div></header>
      <p class="adv-only">The scenario retains its seed, iteration count, and local runtime semantics.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> DWARF keeps the recipe repeatable.</p>
      <dl class="run-wizard__facts" data-run-summary="settings"><div><dt>Seed</dt><dd>Resolving…</dd></div></dl>
    </section>

    <section id="run-stage-readiness" class="run-wizard__step" data-run-step="readiness" aria-labelledby="run-step-readiness">
      <header><span>08</span><div><h2 id="run-step-readiness">Readiness</h2><small>Required before start</small></div></header>
      <p class="adv-only">DWARF checks only the runtime surfaces required by this scenario. Mixed health is not required for unrelated tests.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> DWARF checks the needed parts before it starts.</p>
      <div data-run-summary="readiness" class="run-wizard__list" aria-live="polite">Resolving checks…</div>
      <a href="/operate/status" target="_blank" rel="noreferrer">Open detailed deployment status</a>
    </section>

    <section id="run-stage-review" class="run-wizard__step run-wizard__step--wide" data-run-step="review" aria-labelledby="run-step-review">
      <header><span>09</span><div><h2 id="run-step-review">Review</h2><small>Required</small></div></header>
      <p class="adv-only">Review the resolved target, exact versions, measurements, and readiness contract.</p>
      <div data-run-errors class="run-wizard__errors" role="alert" aria-live="assertive" tabindex="-1" hidden></div>
      <div data-run-summary="review" class="run-wizard__review">Resolving plan…</div>
      <details><summary>Technical plan</summary><pre data-run-summary="plan"></pre></details>
    </section>

    <section id="run-stage-launch" class="run-wizard__step run-wizard__step--wide" data-run-step="launch" aria-labelledby="run-step-launch">
      <header><span>10</span><div><h2 id="run-step-launch">Run</h2><small>Mutating action</small></div></header>
      <p>Starting a run requires the dashboard token. Output streams here and the completed run opens in the normal evidence viewer.</p>
      <p class="run-wizard__plain"><strong>Plain meaning:</strong> Press Start when every check is ready.</p>
      <button class="cta" type="submit" data-run-action="start" disabled>Start local run</button>
      <div class="run-wizard__launch-status" data-run-launch-status aria-live="polite">Resolve a valid plan to continue.</div>
      <pre data-run-launch-log tabindex="0" hidden></pre>
    </section>
  </div></form>
  <script type="application/json" id="run-wizard-bootstrap">{{ wizard|tojson }}</script>
</section>
<script type="module" src="/static/js/run-wizard.js"></script>
{% endblock %}
