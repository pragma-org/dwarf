{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_scenario_discovery.j2" import discovery_filters, scenario_face, scenario_facet_attributes with context %}
<h1 class="visually-hidden">Run</h1>
<section id="run-wizard" class="run-wizard run-wizard--basic" data-basic-reducer="skip" data-resolve-url="/api/run/resolve" data-topology-url="/api/topology/configurations" data-prepare-url="/api/run/prepare" data-start-url="/api/run/start" data-dashboard-token="{{ token }}">
  <figure class="run-readiness-logo run-readiness-logo--centered" data-run-logo-state="unconfigured" aria-labelledby="run-readiness-text">
    <span class="run-readiness-logo__image" aria-hidden="true"><img src="/static/dwarf-logo.png" alt=""><span class="run-readiness-logo__fill"><img src="/static/dwarf-logo.png" alt=""></span></span>
    <figcaption id="run-readiness-text" class="visually-hidden" data-run-readiness-text aria-live="polite">Choose a supported topology to begin.</figcaption>
  </figure>
  <nav class="run-wizard__progress" aria-label="Basic run stages"><ol>
    {% for key, label in [('topology', 'Topology'), ('versions', 'Versions'), ('scenario', 'Scenario'), ('measurements', 'Measurement taps'), ('review', 'Prepare'), ('launch', 'Run + evidence')] %}
    <li><a href="#run-stage-{{ key }}" data-run-progress="{{ key }}"{% if loop.first %} aria-current="step"{% endif %}><span>{{ loop.index }}</span>{{ label }}</a></li>
    {% endfor %}
  </ol></nav>
  <form data-run-wizard-form novalidate><div class="run-wizard__layout">
    <section id="run-stage-topology" class="run-wizard__step run-wizard__step--wide" data-run-step="topology" aria-labelledby="run-step-topology">
      <header><span>01</span><div><h2 id="run-step-topology">Topology</h2><small>Existing or new</small></div></header>
      <p>Reuse an exact deployed profile or create a constrained local topology. DWARF never replaces an existing topology silently.</p>
      <fieldset class="run-choice-grid"><legend>Topology source</legend>
        <label><input type="radio" name="topology_mode" value="existing" checked> <strong>Use existing</strong><span>Choose a catalogued profile; healthy matching nodes are reused.</span></label>
        <label><input type="radio" name="topology_mode" value="new"> <strong>Create new</strong><span>Preview and save a bounded, catalog-resolved local profile.</span></label>
      </fieldset>
      <div data-topology-mode-panel="existing">
        <label for="run-profile">Deployment profile</label>
        <select id="run-profile" name="profile_id"><option value="">Scenario default</option>{% for group in wizard.profile_groups %}<optgroup label="{{ group.label }}">{% for profile in group.profiles %}<option value="{{ profile.id }}" data-haskell-count="{{ profile.haskell_count }}" data-amaru-count="{{ profile.amaru_count }}" data-full-label="{{ profile.label }}" data-status-label="{{ profile.status_label }}">{{ profile.picker_label }}</option>{% endfor %}</optgroup>{% endfor %}</select>
        <div class="run-wizard__selection" data-run-summary="profile">Scenario default</div>
      </div>
      <fieldset class="run-choice-grid" data-topology-mode-panel="new" hidden><legend>Implementation</legend>
        {% for key, label in [('cardano-node', 'Cardano'), ('amaru', 'Amaru'), ('mixed', 'Mixed')] %}
        <label data-topology-kind="{{ key }}"><input type="radio" name="topology_kind" value="{{ key }}"{% if loop.first %} checked{% endif %}> <strong>{{ label }}</strong><span data-topology-kind-detail>{{ 'Cardano and Amaru nodes sharing one generated devnet.' if key == 'mixed' else 'A generated local ' ~ label ~ ' topology.' }}</span></label>
        {% endfor %}
        <div class="run-topology-builder">
          <label for="run-topology-id">Configuration name<input id="run-topology-id" name="topology_id" pattern="[a-z0-9][a-z0-9\-]{0,62}" value="dwarf-basic-run" autocomplete="off"></label>
          <label for="run-cardano-count">Cardano nodes<input id="run-cardano-count" name="haskell_count" type="number" min="0" max="32" value="1"></label>
          <label for="run-amaru-count">Amaru nodes<input id="run-amaru-count" name="amaru_count" type="number" min="0" max="32" value="0"></label>
          <label for="run-network-magic">Local network magic<input id="run-network-magic" name="network_magic" type="number" min="1" max="4294967295" value="42"></label>
        </div>
        <p class="run-wizard__selection" data-topology-builder-status role="status" aria-live="polite">This configuration will be previewed before it can be prepared.</p>
      </fieldset>
    </section>
    <section id="run-stage-versions" class="run-wizard__step" data-run-step="versions" aria-labelledby="run-step-versions">
      <header><span>02</span><div><h2 id="run-step-versions">Node Versions</h2></div></header>
      <label for="run-version-policy">Version policy</label>
      <select id="run-version-policy" name="version_policy"><option value="">Profile default</option>{% for policy in wizard.version_policies %}<option value="{{ policy }}">{{ policy }}</option>{% endfor %}</select>
      <div class="run-wizard__version-grid">
        <label for="run-cardano-version">Cardano-node version <span class="field-optional">Exact only</span><select id="run-cardano-version" name="cardano_version"><option value="">Resolved by policy</option>{% for release in wizard.versions if release.implementation == 'cardano-node' %}<option value="{{ release.version }}" data-downloadable="{{ 'true' if release.downloadable else 'false' }}" data-support-cardano="{{ release.support['cardano-only'] }}" data-support-mixed="{{ release.support['mixed'] }}">{{ release.version }} · {{ release.channel }} · {{ release.artifact_state }} · {{ 'downloadable' if release.downloadable else 'not downloadable' }} · Cardano {{ release.support['cardano-only'] }} · mixed {{ release.support['mixed'] }}</option>{% endfor %}</select></label>
        <label for="run-amaru-version">Amaru version <span class="field-optional">Exact only</span><select id="run-amaru-version" name="amaru_version"><option value="">Resolved by policy</option>{% for release in wizard.versions if release.implementation == 'amaru' %}<option value="{{ release.version }}" data-downloadable="{{ 'true' if release.downloadable else 'false' }}" data-support-amaru="{{ release.support['amaru-only'] }}" data-support-mixed="{{ release.support['mixed'] }}">{{ release.version }} · {{ release.channel }} · {{ release.artifact_state }} · {{ 'downloadable' if release.downloadable else 'not downloadable' }} · Amaru {{ release.support['amaru-only'] }} · mixed {{ release.support['mixed'] }}</option>{% endfor %}</select></label>
      </div>
      <label for="run-operator-registration">Local inspected version <span class="field-optional">Experimental / local</span>
        <select id="run-operator-registration" name="operator_registration_id">
          <option value="">Use the shared catalog selection above</option>
          {% for registration in wizard.operator_registrations %}<option value="{{ registration.registration_id }}" data-implementation="{{ registration.implementation }}" data-config-image-id="{{ registration.config_image_id }}">{{ registration.version }} · {{ registration.implementation }} · {{ registration.platform }} · source {{ 'declared' if registration.source_declared else 'unverified' }} · qualification {{ registration.qualification }}</option>{% endfor %}
        </select>
      </label>
      {% if wizard.operator_registration_error %}<p class="inline-warning">Local registrations are unavailable: {{ wizard.operator_registration_error }}</p>{% elif not wizard.operator_registrations %}<p class="run-wizard__selection">No local image is registered. Inspect one from <a href="/operate/versions">Versions</a>, then return here to select its immutable identity.</p>{% else %}<p class="run-wizard__selection">A local selection uses its controller-inspected immutable identity. It does not alter shared qualification or the catalog default.</p>{% endif %}
      <details class="run-wizard__catalog" data-version-catalog-details><summary>Catalog information</summary><p>Catalog <code>{{ wizard.version_catalog_revision }}</code>. Unsupported and unavailable pins remain visible so DWARF can explain why they cannot run.</p></details>
      <label class="run-wizard__check" data-version-acknowledgement hidden><input type="checkbox" name="acknowledge_unknown_versions"> Acknowledge this exact unconfirmed or local version for this run</label>
      <div class="run-wizard__selection" data-run-summary="versions">Resolve a scenario and topology to see exact identities.</div>
    </section>
    <section id="run-stage-scenario" class="run-wizard__step" data-run-step="scenario" aria-labelledby="run-step-scenario">
      <header><span>03</span><div><h2 id="run-step-scenario">Scenario</h2><small>Purpose and requirements</small></div></header>
      <label id="run-scenario-picker-label" for="run-scenario">Scenario</label>
      <select id="run-scenario" name="scenario_id" required class="run-wizard__canonical-select" tabindex="-1" aria-hidden="true">{% if not wizard.default_scenario_id %}<option value="" selected disabled>Select a supported scenario</option>{% endif %}{% for scenario in wizard.scenarios %}<option value="{{ scenario.id }}"{% if scenario.id == wizard.default_scenario_id %} selected{% endif %}>{{ scenario.short_title }}</option>{% endfor %}</select>
      <div class="scenario-discovery" data-scenario-discovery data-discovery-scope="run">
      {{ discovery_filters('run', wizard.scenario_facets, wizard.scenario_counts) }}
      <div class="scenario-picker" data-scenario-picker role="listbox" aria-labelledby="run-scenario-picker-label" tabindex="0">
        {% for subject in wizard.scenario_subjects %}
        <details class="scenario-discovery__subject" data-scenario-disclosure="subject:{{ subject.key }}">
          <summary><span>{{ subject.title }}</span><small>{{ subject.variant_count }} exact variant{{ '' if subject.variant_count == 1 else 's' }}</small><span class="scenario-discovery__selected-badge" data-selected-ancestor-badge hidden>✓ Selected</span></summary>
          {% for child in subject.children %}{% if child.variant_count %}
          <section class="scenario-discovery__subject-child" data-scenario-subject-child="{{ subject.key }}:{{ child.key }}">
            {% if child.key != 'general' %}<h3>{{ child.title }}</h3>{% endif %}
            {% for family in child.families %}
            <details class="scenario-discovery__family" data-scenario-disclosure="family:{{ subject.key }}:{{ child.key }}:{{ family.key }}">
              <summary><span>{{ family.title }}</span><small>{{ family.variant_count }} exact variant{{ '' if family.variant_count == 1 else 's' }}</small><span class="scenario-discovery__selected-badge" data-selected-ancestor-badge hidden>✓ Selected</span></summary>
              {% for scenario in family.variants %}{% set visual_class = 'cardano' if scenario.implementation_key == 'cardano-node' else scenario.implementation_key if scenario.implementation_key in ['amaru', 'mixed'] else 'neutral' %}
              <button type="button" role="option" class="scenario-picker__option scenario-picker__option--{{ visual_class }}" {{ scenario_facet_attributes(scenario) }} data-recommended="{{ 'true' if scenario.quickstart_recommended else 'false' }}" aria-selected="{{ 'true' if scenario.id == wizard.default_scenario_id else 'false' }}">{{ scenario_face(scenario, false) }}</button>
              {% endfor %}
            </details>
            {% endfor %}
          </section>
          {% endif %}{% endfor %}
        </details>
        {% endfor %}
      </div>
      </div>
      <details class="scenario-selection" data-scenario-summary aria-live="polite"><summary><span>Selected scenario:</span><strong data-scenario-summary-title>Selected scenario</strong><span class="scenario-selection__badge" data-scenario-selected-badge>✓ Selected</span></summary><div class="scenario-selection__body"><dl class="run-wizard__facts" data-scenario-summary-facts></dl><p data-scenario-summary-purpose></p><p data-scenario-summary-limit></p><p data-scenario-summary-evidence></p><div data-scenario-summary-context></div><details data-scenario-technical><summary>Technical scenario ID</summary><code data-scenario-raw-id></code></details></div></details>
      <a href="/operate/scenarios/new" target="_blank" rel="noreferrer">Customize as a new scenario</a>
    </section>
    <section id="run-stage-measurements" class="run-wizard__step" data-run-step="measurements" aria-labelledby="run-step-measurements">
      <header><span>04</span><div><h2 id="run-step-measurements">Measurement taps</h2></div></header>
      <label for="run-measurements">Measurement profile <span class="field-optional">Optional override</span></label><select id="run-measurements" name="measurement_profile"><option value="">Scenario or compatible default</option><option value="none">No measurements</option>{% for profile in wizard.measurement_profiles %}<option value="{{ profile.id }}">{{ profile.title }} · {{ profile.measurement_count }} taps</option>{% endfor %}</select>
      <fieldset class="run-measurement-taps" data-run-measurement-taps><legend class="run-measurement-taps__legend">Individual compatible taps</legend><details class="run-measurement-taps__disclosure" data-measurement-taps-disclosure><summary>Individual taps · resolving</summary><div class="run-measurement-taps__body"><p>Resolve a compatible profile to choose individual taps.</p></div></details></fieldset>
    </section>
    <section id="run-stage-review" class="run-wizard__step run-wizard__step--wide" data-run-step="review" aria-labelledby="run-step-review">
      <header><span>05</span><div><h2 id="run-step-review">Review and prepare</h2><small>Exact change</small></div></header>
      <div data-run-errors class="run-wizard__errors" role="alert" aria-live="assertive" tabindex="-1" hidden></div>
      <div data-run-summary="review" class="run-wizard__review">Resolving plan…</div>
      <dl class="run-wizard__facts" data-run-summary="target"><div><dt>Target</dt><dd>Resolving…</dd></div></dl>
      <div class="run-wizard__review-grid"><div><h3>Scenario operations</h3><div data-run-summary="primitives" class="run-wizard__list"></div></div><div><h3>Prepare will verify</h3><div data-run-summary="readiness" class="run-wizard__list"></div></div></div>
      <details class="run-wizard__reproducibility" data-run-reproducibility><summary>Reproducibility</summary><label for="run-seed">Seed override <span class="field-optional">Optional</span><input id="run-seed" name="seed" data-run-seed inputmode="text" autocomplete="off" placeholder="Scenario default, decimal, or 0x hexadecimal"></label><p>Leave blank to use the scenario default. A supplied value is frozen into the exact prepared plan.</p></details>
      <dl class="run-wizard__facts" data-run-summary="settings"><div><dt>Seed</dt><dd>Resolving…</dd></div></dl>
      <label class="run-wizard__check" data-destructive-confirmation hidden><input type="checkbox" name="confirm_topology_change"> I understand Prepare will replace or redeploy the currently selected DWARF-owned topology.</label>
      <button class="cta cta--ghost" type="button" data-run-action="prepare" aria-label="Prepare exact configuration" disabled>Prepare</button>
      <p class="run-wizard__launch-status" data-run-prepare-status aria-live="polite">Resolve a valid plan to continue.</p><pre data-run-prepare-log tabindex="0" hidden></pre>
      <details class="adv-only"><summary>Technical resolved plan</summary><pre data-run-summary="plan"></pre></details>
    </section>
    <section id="run-stage-launch" class="run-wizard__step run-wizard__step--wide" data-run-step="launch" aria-labelledby="run-step-launch">
      <header><span>06</span><div><h2 id="run-step-launch">Run and evidence</h2><small data-basic-run-gate>Locked</small></div></header>
      <p>Run the exact prepared digest. DWARF records one queued/running/terminal lifecycle and retains the real result even when assertions fail.</p>
      <div class="run-basic__lifecycle" aria-label="Run lifecycle"><span data-run-lifecycle="queued">Queued</span><span data-run-lifecycle="running">Running</span><span data-run-lifecycle="completed">Terminal</span></div>
      <button class="cta" type="submit" data-run-action="start" disabled>Run prepared scenario</button>
      <div class="run-wizard__launch-status" data-run-launch-status aria-live="polite">Prepare the exact plan before starting.</div><p data-run-basic-evidence aria-live="polite">No run has started.</p><pre data-run-launch-log tabindex="0" hidden></pre>
    </section>
  </div></form>
  <script type="application/json" id="run-wizard-bootstrap">{{ wizard_bootstrap|tojson }}</script>
</section>
<script type="module" src="/static/js/scenario-discovery.js"></script>
<script type="module" src="/static/js/run-wizard.js"></script>
{% endblock %}
