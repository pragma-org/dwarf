{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_deck.j2" import deck_head, deck_grid, deck_more, deck_nice, deck_actions with context %}
{% if ui == "basic" %}
{{ deck_head('Operate · Generation grammars', (rows|length) ~ ' grammar sets expose ' ~ token_count ~ ' mutation tokens — ' ~ ready_count ~ ' validate cleanly.', 'Grammars shape what fuzzers generate. A valid grammar is a definition, not evidence that anything was found.') }}
{% set cards = [] %}
{% for row in rows %}{% set lab = row.label %}
{% set impl = 'amaru' if lab.startswith('amaru') else ('cardano-node' if lab.startswith('cardano') else '') %}
{% set fuzzer = 'cargo-fuzz' if 'cargo-fuzz' in lab else ('AFL++' if 'afl' in lab else '') %}
{% set shape = lab.replace('amaru-cargo-fuzz-', '').replace('cardano-node-', '') %}
{% set ok = row.status in ['valid','ok','ready','available'] and row.structure_status in ['valid', 'ok'] and row.dictionary_status in ['valid', 'ok'] %}
{% set issues = [] %}{% if row.structure_status not in ['valid', 'ok'] %}{% set _ = issues.append('structure ' ~ row.structure_status) %}{% endif %}{% if row.dictionary_status not in ['valid', 'ok'] %}{% set _ = issues.append('dictionary ' ~ row.dictionary_status) %}{% endif %}
{% set _ = cards.append({'title': deck_nice(shape, false)|trim, 'full_title': lab ~ ' — ' ~ (row.decoder_entrypoint or ''), 'id': row.id, 'hide_id': true,
  'href': '/operate/grammars/' ~ row.id, 'accent': impl,
  'kicker': ('editable clone' if row.writable else 'shipped') ~ ((' · ▲ ' ~ issues|join(', ')) if issues else ''),
  'tier': 'back' if ok else 'warn', 'tone': '' if ok else 'dk-g-warn',
  'sub': row.token_count ~ ' mutation token' ~ ('' if row.token_count == 1 else 's'),
  'tags': ([impl] if impl else []) + ([(row.format or '')|upper] if row.format else []) + ([fuzzer] if fuzzer else []),
  'search': lab ~ ' ' ~ (row.target or '') ~ ' ' ~ (row.scenario_ids|join(' ')) ~ ' ' ~ (row.corpus_ids|join(' '))}) %}{% endfor %}
{{ deck_grid(cards, label='grammar sets', empty='No generation grammar roots are available.') }}
{{ deck_more('Structures, dictionaries and cloning in Advanced') }}
{{ deck_actions([('Download all', '/api/grammars/export', false, true)]) }}
{% endif %}
<div class="adv-only">
<header class="scenarios-header">
  <div>
    <span class="eyebrow">Operate · generation assets</span>
    <h1>Generation grammars</h1>
    <p class="page-hero"><strong>{{ rows|length }} structure/token sets</strong> expose {{ token_count }} parsed mutation tokens. {{ ready_count }} definitions validate cleanly; shipped sources are read-only.</p>
  </div>
  <div class="definition-actions">
    <a class="cta cta--ghost" href="/learn/grammars" target="_blank" rel="noopener">Learn generation assets</a>
    <a class="cta cta--ghost" href="/api/grammars/export" download>Download all</a>
  </div>
</header>
<hr class="hairline">
<div class="filter-bar">
  <label for="grammar-search" class="eyebrow">Search</label>
  <input id="grammar-search" type="search" aria-label="Search generation grammars" placeholder="Grammar, target, format, source, relationship, or status">
  <p class="filter-count" aria-live="polite"><span data-grammar-count>{{ rows|length }}</span> structure/token sets</p>
</div>
{% if rows %}
<div class="learn-tile-grid">
  {% for row in rows %}
  <article class="learn-tile" data-grammar-row data-search="{{ row.id }} {{ row.label }} {{ row.target or '' }} {{ row.format or '' }} {{ row.status }} {{ row.root_kind }} {{ row.scenario_ids|join(' ') }} {{ row.target_ids|join(' ') }} {{ row.corpus_ids|join(' ') }}">
    <span class="learn-tile__eyebrow">{{ row.root_kind }} · {{ row.format or 'unknown format' }} · {{ row.status }}</span>
    <h2 class="learn-tile__title"><a href="/operate/grammars/{{ row.id }}"><code>{{ row.label }}</code></a></h2>
    <p class="learn-tile__sub">{{ row.target or 'target unavailable' }}</p>
    <p class="asset-pill-row">
      <span class="pill pill--v-count">{{ row.token_count }} mutation tokens</span>
      <span class="pill pill--v-{{ row.structure_status|lower }}">structure {{ row.structure_status }}</span>
      <span class="pill pill--v-{{ row.dictionary_status|lower }}">dictionary {{ row.dictionary_status }}</span>
      <span class="pill {{ 'pill--v-writable' if row.writable else 'pill--v-readonly' }}">{{ 'editable runtime clone' if row.writable else 'shipped read-only' }}</span>
    </p>
  </article>
  {% endfor %}
</div>
{% else %}
<p class="empty-section-statement">No generation grammar roots are available from the two explicitly configured locations.</p>
{% endif %}
<script>(()=>{const input=document.getElementById('grammar-search');const rows=[...document.querySelectorAll('[data-grammar-row]')];const count=document.querySelector('[data-grammar-count]');if(!input||!count)return;input.addEventListener('input',()=>{const needle=input.value.trim().toLowerCase();let visible=0;for(const row of rows){const show=!needle||row.dataset.search.toLowerCase().includes(needle);row.hidden=!show;if(show)visible+=1;}count.textContent=String(visible);});})();</script>
</div>
{% endblock %}
