{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_deck.j2" import deck_head, deck_grid, deck_more with context %}
{% if ui == "basic" %}
{{ deck_head('Operate · Testcases', (rows|length) ~ ' retained testcase record' ~ ('' if rows|length == 1 else 's') ~ (' — ' ~ malformed_count ~ ' malformed' if malformed_count else '') ~ '.', 'A testcase is a lead retained for triage, replay and comparison — not a confirmed finding.') }}
{% set cards = [] %}{% for row in rows %}
{% set _ = cards.append({'title': row.id, 'href': '/operate/testcases/' ~ row.id, 'kicker': row.classification ~ ' · ' ~ row.target_implementation,
  'tier': 'warn', 'suit': '▲', 'tone': 'dk-g-warn', 'group': row.target_implementation, 'sub': row.triage_reason,
  'facts': [('Status', row.status), ('Replay', row.replay_state), ('Compare', row.compare_state)], 'search': row.bucket_id ~ ' ' ~ (row.source_run_id or '')}) %}{% endfor %}
{{ deck_grid(cards, label='testcases', empty='No testcase records are retained in the configured state directory.') }}
<section class="basic-only dk" aria-label="Testcase lifecycle actions">
  <div class="dk-panel">
    <h3>{% if rows %}Add more testcases{% else %}How testcases get here{% endif %}</h3>
    <p class="dkb-p">Testcases are recorded from finished runs. Pick a retained run in <a href="/operate/runs">Runs</a>, classify the issue, and keep a short triage reason.</p>
    <form method="post" action="/operate/testcases/ingest">
      <input type="hidden" name="token" value="{{ token }}">
      <label for="testcase-run-id">Retained run ID</label>
      <input id="testcase-run-id" name="run_id" required maxlength="255" autocomplete="off">
      <label for="testcase-classification">Classification</label>
      <input id="testcase-classification" name="classification" required maxlength="128" placeholder="crash">
      <label for="testcase-triage-reason">Triage reason</label>
      <input id="testcase-triage-reason" name="triage_reason" required maxlength="256" placeholder="decoder-abort">
      <button class="dk-btn dk-btn--solid" type="submit">Record testcase</button>
    </form>
    <p class="dkb-p dk-note">CLI alternative:</p>
    <div class="dkb-cmds">{% for item in entrypoints.create %}<div class="dk-cmd"><span class="dk-note">{{ item.label }}</span> <code>{{ item.command }}</code></div>{% endfor %}</div>
  </div>
  {% if rows %}
  <div class="dk-panel">
    <h3>Advance retained cases</h3>
    <div class="dkb-cmds">{% for item in entrypoints.advance %}<div class="dk-cmd"><span class="dk-note">{{ item.label }}</span> <code>{{ item.command }}</code></div>{% endfor %}</div>
  </div>
  {% endif %}
  <div class="dk-panel">
    <h3>Related</h3>
    <div class="dk-row">
      {% if rows %}<a class="dk-btn dk-btn--solid" href="/api/assets/testcases/export" download>Download records</a>{% endif %}
      <a class="dk-btn" href="/operate/testcase-buckets">View buckets</a>
      <a class="dk-btn" href="/operate/runs">Source runs</a>
      <a class="dk-btn" href="/learn/cli#cli-testcase">Testcase commands</a>
    </div>
  </div>
</section>
{{ deck_more('Buckets, provenance and downloads in Advanced') }}
{% endif %}
<div class="adv-only">
<header class="scenarios-header">
  <div><span class="eyebrow">Operate · retained lifecycle</span><h1>Testcases</h1><p class="page-hero"><strong>{{ rows|length }} records</strong> project the canonical testcase state without changing it. Inspect provenance, replay, minimization, comparison, promotion, and retained artifacts.</p></div>
  <div class="definition-actions"><a class="cta cta--ghost" href="/operate/testcase-buckets">View buckets</a><a class="cta cta--ghost" href="/learn/testcases" target="_blank" rel="noopener">Learn the lifecycle</a><a class="cta cta--ghost" href="/api/assets/testcases/export" download>Download records</a></div>
</header>
<hr class="hairline">
<div class="filter-bar">
  <label for="testcase-search" class="eyebrow">Search</label>
  <input id="testcase-search" type="search" aria-label="Search testcases" placeholder="Case, bucket, classification, implementation, run, or reason">
  <p class="filter-count" aria-live="polite"><span data-testcase-count>{{ rows|length }}</span> records{% if malformed_count %} · {{ malformed_count }} malformed{% endif %}</p>
</div>
{% if rows %}
<div class="learn-tile-grid" data-testcase-grid>
  {% for row in rows %}
  <article class="learn-tile" data-testcase-row data-search="{{ row.id }} {{ row.bucket_id }} {{ row.classification }} {{ row.triage_reason }} {{ row.target_implementation }} {{ row.source_run_id }} {{ row.status }}">
    <span class="learn-tile__eyebrow">{{ row.classification }} · {{ row.target_implementation }}</span>
    <h2 class="learn-tile__title"><a href="/operate/testcases/{{ row.id }}"><code>{{ row.id }}</code></a></h2>
    <p class="learn-tile__sub">{{ row.triage_reason }}{% if row.source_run_id %} · run <code>{{ row.source_run_id }}</code>{% endif %}</p>
    <p><span class="pill">{{ row.status }}</span> <span class="pill">replay {{ row.replay_state }}</span> <span class="pill">compare {{ row.compare_state }}</span></p>
    {% if row.bucket_id != 'unbucketed' %}<p><a href="/operate/testcase-buckets/{{ row.bucket_id }}"><code>{{ row.bucket_id }}</code></a></p>{% endif %}
  </article>
  {% endfor %}
</div>
{% else %}<p class="empty-section-statement">No testcase records are retained in the configured state directory.</p>{% endif %}
<script>
(() => {
  const input = document.getElementById('testcase-search');
  const rows = [...document.querySelectorAll('[data-testcase-row]')];
  const count = document.querySelector('[data-testcase-count]');
  if (!input || !count) return;
  input.addEventListener('input', () => {
    const needle = input.value.trim().toLowerCase();
    let visible = 0;
    for (const row of rows) {
      const show = !needle || row.dataset.search.toLowerCase().includes(needle);
      row.hidden = !show;
      if (show) visible += 1;
    }
    count.textContent = String(visible);
  });
})();
</script>
</div>
{% endblock %}
