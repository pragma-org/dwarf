{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_deck.j2" import deck_head, deck_grid, deck_more, deck_actions with context %}
{% from "operate/_partials/_scenario_discovery.j2" import discovery_filters, scenario_face, scenario_facet_attributes with context %}
{% if ui == "basic" %}
{{ deck_head('Operate · Scenarios', total ~ ' scenarios in the catalog — each is a recipe, not a result.',
   'A scenario card says a test is defined and runnable. Only a run with a verified evidence bundle proves anything; open Runs for that.') }}
{{ deck_actions([('+ New scenario', '/operate/scenarios/new', true, false), ('Download all', '/api/catalog/scenarios/export', false, true)]) }}
{% endif %}
<div class="scenarios-header adv-only">
  <div>
    <span class="eyebrow">Operate</span>
    <h1>Scenarios</h1>
  </div>
  <div class="definition-actions">
    <a class="cta cta--ghost" href="/api/catalog/scenarios/export" download>Download all</a>
    <a class="cta" href="/operate/scenarios/new">+ New scenario</a>
  </div>
</div>
<p class="adv-only">All scenarios visible to the dashboard, derived from <code>dwarf/scenarios/*.yaml</code> at request time. Filter by family to narrow the list; the filter is client-side and refresh resets it.</p>

<form class="run-scenario adv-only" method="get" action="/run" style="margin:14px 0;background:var(--obsidian-2);border:1px solid var(--rule);border-radius:12px;padding:14px 16px">
  <span class="eyebrow">Run a scenario</span>
  <p class="page-subhero" style="margin:4px 0 8px">Pick a scenario, then review its topology, versions, measurement taps and exact execution plan in the canonical Run workflow.</p>
  {% if auto_redeploy_enabled %}
  <p class="auto-repair-warning"><strong>AUTO-REPAIR ENABLED FOR ATTACHED SCENARIOS</strong> If the mixed topology fails preflight, DWARF will preserve evidence and make one redeploy attempt before deciding whether the workload may start. <a href="/operate/config/edit">Review setting</a>.</p>
  {% endif %}
  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <label class="visually-hidden" for="run-scn-id">Scenario id</label>
    <input id="run-scn-id" name="scenario" list="run-scn-list" required placeholder="scenario id — e.g. amaru-cbor-tx-body-fuzz" style="flex:1;min-width:280px;background:var(--obsidian-1);border:1px solid var(--rule);color:var(--ink);border-radius:8px;padding:8px 11px;font-family:var(--font-mono);font-size:.84rem">
    <datalist id="run-scn-list">{% for r in rows %}<option value="{{ r.id }}">{% endfor %}</datalist>
    <button id="run-scn-btn" type="submit" style="background:var(--accent);color:var(--obsidian-0);border:none;border-radius:8px;padding:8px 18px;font-weight:700;cursor:pointer">Configure &amp; run</button>
  </div>
</form>

{% if shim_enabled and coverage_ids %}
<div class="run-coverage" style="margin:14px 0;background:var(--obsidian-2);border:1px solid var(--rule);border-radius:12px;padding:14px 16px">
  <span class="eyebrow">Run AFL coverage (on the substrate host)</span>
  <p class="page-subhero" style="margin:4px 0 8px">Coverage-guided cardano-node fuzz campaigns can't run in this hardened container (AFL forkserver needs host privileges), so they run on the substrate host over the restricted control channel. Output streams below.</p>
  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
    <label class="visually-hidden" for="run-cov-id">Coverage scenario id</label>
    <input id="run-cov-id" list="run-cov-list" placeholder="coverage scenario id — e.g. cardano-node-cov-applyblock-aflpp-smoke" style="flex:1;min-width:320px;background:var(--obsidian-1);border:1px solid var(--rule);color:var(--ink);border-radius:8px;padding:8px 11px;font-family:var(--font-mono);font-size:.84rem">
    <datalist id="run-cov-list">{% for c in coverage_ids %}<option value="{{ c }}">{% endfor %}</datalist>
    <button id="run-cov-btn" type="button" onclick="runCov()" style="background:var(--accent);color:var(--obsidian-0);border:none;border-radius:8px;padding:8px 18px;font-weight:700;cursor:pointer">Run on host</button>
  </div>
  <pre id="run-cov-out" style="margin:10px 0 0;background:#04060a;border:1px solid var(--rule);border-radius:10px;padding:12px 14px;min-height:56px;max-height:340px;overflow:auto;white-space:pre-wrap;word-break:break-word;font-family:var(--font-mono);font-size:.78rem;color:#cfeaea;display:none"></pre>
</div>
<script>
function coverageToken(){return new URLSearchParams(location.search).get('token')||'{{ token }}'||'dwarf';}
async function runCov(){
  var id=(document.getElementById('run-cov-id').value||'').trim();
  if(!id){return;}
  var out=document.getElementById('run-cov-out'); out.style.display='block'; out.textContent='$ coverage run '+id+'  (host)\n';
  var btn=document.getElementById('run-cov-btn'); btn.disabled=true;
  try{
    var resp=await fetch('/api/coverage/run?token='+encodeURIComponent(coverageToken())+'&id='+encodeURIComponent(id),{method:'POST'});
    if(!resp.ok){out.textContent+='HTTP '+resp.status+': '+(await resp.text());return;}
    var rd=resp.body.getReader(),dec=new TextDecoder(),buf='';
    while(true){var r=await rd.read();if(r.done)break;buf+=dec.decode(r.value,{stream:true});var parts=buf.split('\n\n');buf=parts.pop();
      for(var p of parts){for(var line of p.split('\n')){if(line.indexOf('data: ')===0){out.textContent+=line.slice(6)+'\n';out.scrollTop=out.scrollHeight;}else if(line.indexOf('event: done')===0){out.textContent+='[done]\n';}}}}
  }catch(e){out.textContent+='\n[error] '+String(e);}
  finally{btn.disabled=false;}
}
</script>
{% endif %}

<details class="paste-scenario" id="paste-scenario">
  <summary class="paste-scenario__summary">
    <span class="eyebrow">Paste a scenario</span>
    <span class="paste-scenario__hint">Drop YAML in to validate and stage as a pending scenario</span>
  </summary>
  <div class="paste-scenario__body">
    <p class="page-subhero">YAML is validated against <code>dwarf/spec/v1/schema.json</code> and, if valid, written to <code>dwarf/scenarios/pending/&lt;id&gt;.yaml</code>. Promotion into the live corpus is a separate step (<code>cardano-profile scenario promote</code>) gated on declared promotion blockers.</p>
    <label class="paste-scenario__label" for="paste-scenario-yaml">
      <span class="eyebrow">Scenario YAML</span>
    </label>
    <textarea id="paste-scenario-yaml" class="paste-scenario__textarea" rows="14" autocomplete="off" spellcheck="false" placeholder="id: my-new-scenario&#10;title: ...&#10;runtime: library&#10;target_id: ...&#10;steps:&#10;  - ..."></textarea>
    <div class="paste-scenario__actions">
      <input type="hidden" id="paste-scenario-token" value="{{ token }}">
      <button type="button" class="cta cta--primary" data-paste-submit data-endpoint="/api/scenario/paste">Validate &amp; stage</button>
      <button type="button" class="cta cta--ghost" data-paste-clear>Clear</button>
    </div>
    <pre class="paste-scenario__output" data-paste-output hidden></pre>
  </div>
</details>

{% if ui == "basic" %}
<section class="scenario-discovery" data-scenario-discovery data-discovery-scope="catalog">
  {{ discovery_filters('catalog', scenario_facets, scenario_counts) }}
  <div class="scenario-discovery__families">
  {% for subject in scenario_subjects %}
    <details class="scenario-discovery__subject" data-scenario-disclosure="subject:{{ subject.key }}">
      <summary><span>{{ subject.title }}</span><small>{{ subject.variant_count }} exact variant{{ '' if subject.variant_count == 1 else 's' }}</small></summary>
      {% for child in subject.children %}{% if child.variant_count %}
      <section class="scenario-discovery__subject-child" data-scenario-subject-child="{{ subject.key }}:{{ child.key }}">
        {% if child.key != 'general' %}<h3>{{ child.title }}</h3>{% endif %}
        {% for family in child.families %}
        <details class="scenario-discovery__family" data-scenario-disclosure="family:{{ subject.key }}:{{ child.key }}:{{ family.key }}">
          <summary><span>{{ family.title }}</span><small>{{ family.variants|length }} exact variant{{ '' if family.variants|length == 1 else 's' }}</small></summary>
          <div class="scenario-discovery__variants">
          {% for scenario in family.variants %}
            <article class="scenario-picker__option scenario-picker__option--{{ 'cardano' if scenario.implementation_key == 'cardano-node' else scenario.implementation_key if scenario.implementation_key in ['amaru', 'mixed'] else 'neutral' }}" {{ scenario_facet_attributes(scenario) }}>
              {{ scenario_face(scenario) }}
              <span class="scenario-discovery__links"><a class="cta" href="/run?scenario={{ scenario.id }}">Configure exact variant</a><a href="{{ scenario.url }}">Technical details</a></span>
            </article>
          {% endfor %}
          </div>
        </details>
        {% endfor %}
      </section>
      {% endif %}{% endfor %}
    </details>
  {% endfor %}
  </div>
</section>
{% endif %}
<div class="adv-only">
<hr class="hairline">

<div class="filter-bar">
  <span class="eyebrow">Family</span>
  <div class="filter-pills" role="group" aria-label="Filter by family">
    <button type="button" class="pill" data-family="" aria-pressed="true">all</button>
    {% for family in families %}
    <button type="button" class="pill" data-family="{{ family.slug }}" aria-pressed="false">{{ family.label }}</button>
    {% endfor %}
  </div>
  <p class="filter-count" aria-live="polite">{{ total }} scenarios</p>
</div>

<ul class="scenario-list">
{% for row in rows %}
{% include "operate/_partials/_scenario_row.j2" %}
{% endfor %}
</ul>
</div>

<script type="module" src="/static/js/scenario-filter.js"></script>
<script type="module" src="/static/js/scenario-discovery.js"></script>
<script type="module" src="/static/js/paste-scenario.js"></script>
{% endblock %}
