{% extends "_base.j2" %}
{% block main %}
<nav class="definition-breadcrumb" aria-label="Breadcrumb"><a href="/operate/testcase-buckets">Testcase buckets</a><span aria-hidden="true">/</span><span>{{ bucket.id }}</span></nav>
<header class="definition-header"><div><span class="eyebrow">{{ bucket.classification }} · {{ bucket.case_count }} case{{ '' if bucket.case_count == 1 else 's' }}</span><h1>{{ bucket.id }}</h1><p class="page-hero">{{ bucket.triage_reason }} · {{ bucket.target_implementation }}</p></div><div class="definition-actions"><a class="cta cta--ghost" href="/api/assets/testcase-buckets/{{ bucket.id }}/export" download>Export with manifest</a><a class="cta cta--ghost" href="/api/assets/testcase-buckets/{{ bucket.id }}/download" download>Download bucket</a></div></header>
<dl class="definition-summary"><div><dt>Cases</dt><dd><code>{{ bucket.case_count }}</code></dd></div><div><dt>Classification</dt><dd><code>{{ bucket.classification }}</code></dd></div><div><dt>Target</dt><dd><code>{{ bucket.target_implementation }}</code></dd></div><div><dt>Promotion</dt><dd><code>{{ bucket.promotion_state }}</code></dd></div><div><dt>Replay pending</dt><dd><code>{{ bucket.pending_replay_count }}</code></dd></div><div><dt>Compare pending</dt><dd><code>{{ bucket.pending_compare_count }}</code></dd></div></dl>
<section><span class="eyebrow">Membership</span><h2>Cases in this bucket</h2><div class="learn-tile-grid">{% for member in bucket.members %}<article class="learn-tile"><span class="learn-tile__eyebrow">{{ member.classification }} · {{ member.target_implementation }}</span><h3 class="learn-tile__title"><a href="/operate/testcases/{{ member.id }}"><code>{{ member.id }}</code></a></h3><p class="learn-tile__sub">{{ member.triage_reason }} · {{ member.status }}</p></article>{% endfor %}</div></section>
<section class="definition-source"><div class="definition-source__head"><div><span class="eyebrow">Grouping key</span><h2>Bucket signature</h2></div></div><pre><code>{{ bucket.bucket_signature|tojson(indent=2) }}</code></pre></section>
{% endblock %}
