{% extends "_base.j2" %}
{% block main %}
<span class="eyebrow">Operate</span>
<h1>Runs</h1>
<p>Ledger-backed run history, newest first. Running work appears before its manifest exists; completed runs retain their test verdict separately from the operational outcome. Open an inspectable run for its exact primitive inventory and retained evidence.</p>

<nav class="filter-pills" aria-label="Run history kind">
  <a class="pill{% if history_scope == 'scenario' %} pill--active{% endif %}" href="/operate/runs?scope=scenario">Scenarios ({{ history_scope_totals.scenario }})</a>
  <a class="pill{% if history_scope == 'ci' %} pill--active{% endif %}" href="/operate/runs?scope=ci">CI ({{ history_scope_totals.ci }})</a>
  <a class="pill{% if history_scope == 'external' %} pill--active{% endif %}" href="/operate/runs?scope=external">External / legacy ({{ history_scope_totals.external }})</a>
  <a class="pill{% if history_scope == 'operations' %} pill--active{% endif %}" href="/operate/runs?scope=operations">Operations ({{ history_scope_totals.operations }})</a>
  <a class="pill{% if history_scope == 'all' %} pill--active{% endif %}" href="/operate/runs?scope=all">All ({{ history_scope_totals.all }})</a>
</nav>

<hr class="hairline">

{% if families %}
<section class="issue-families adv-only" aria-labelledby="issue-families-heading">
  <header class="issue-families__head">
    <span class="eyebrow">Issue families</span>
    <h2 id="issue-families-heading">Runtime-anomaly families across recent runs</h2>
    <p class="page-subhero">Aggregated triage groupings from the testcase lifecycle ({{ runtime_anomaly_count }} runtime-anomaly case{{ '' if runtime_anomaly_count == 1 else 's' }} total). Each row groups one (triage reason, implementation) family and counts the cases that have landed there.</p>
  </header>
  <table class="config-table issue-families__table">
    <thead>
      <tr>
        <th>Triage reason</th>
        <th>Implementation</th>
        <th>Buckets</th>
        <th>Cases</th>
        <th>Pending replay</th>
      </tr>
    </thead>
    <tbody>
      {% for fam in families %}
      <tr>
        <td><code>{{ fam.triage_reason }}</code></td>
        <td>{{ fam.target_implementation }}</td>
        <td>{{ fam.bucket_count }}</td>
        <td>{{ fam.case_count }}</td>
        <td>{{ fam.pending_replay_count }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<hr class="hairline">
{% endif %}

{% if empty %}
<p class="empty-section-statement empty-section-statement--runs">
  No forensic runs recorded yet.
  <span class="empty-section-statement__cite">scanned <code>dwarf/runs/</code>, 0 runs with manifests</span>
</p>
{% else %}
{% if ui == "basic" %}
{% set np = rows|selectattr('display_status','equalto','pass')|list|length %}
{% set nf = rows|selectattr('display_status','equalto','fail')|list|length %}
{% set ne = rows|selectattr('display_status','equalto','error')|list|length %}
{% set ni = rows|selectattr('display_status','equalto','inconclusive')|list|length %}
<section class="basic-only dk runs-basic" aria-label="Runs as a hand of cards">
  <h2 class="dk-lead" style="margin-top:0">{{ np }} passed, {{ nf }} failed, {{ ne }} errored{% if ni %}, {{ ni }} inconclusive{% endif %}{% if rows|length - np - nf - ne - ni > 0 %}, {{ rows|length - np - nf - ne - ni }} other{% endif %}.</h2>
  <p class="dk-plain">One card per run, newest first. The suit is the recorded result; open a run to see whether its evidence bundle verifies before trusting it.</p>
  <div class="dk-hand-wrap">
    <div class="dk-hand">
      {% for r in rows %}{% set st = r.display_status if r.display_status in ('pass','fail','error','inconclusive') else 'other' %}
      <a class="dk-mini {{ st }}{% if measured.get(r.run_id) %} dk-mini--measured{% endif %}" href="{{ r.run_url if r.inspectable else '#' }}" aria-label="{{ r.display_status or 'unknown' }} · {{ r.target_implementation or '—' }} · {{ r.scenario_id or '—' }} · {{ r.ended_at or r.started_at or '' }} · {{ r.run_id }}">{{ {'pass':'♦','fail':'▲','error':'✕'}.get(st, '■') }}</a>
      {% endfor %}
    </div>
    <p class="dk-readout" data-dk-readout aria-live="polite">Hover or focus a card to read it · newest on the left</p>
    <div class="dk-hand-legend"><span class="dk-g-pass"><b>♦</b> pass</span><span class="dk-g-fail"><b>▲</b> fail</span><span class="dk-g-error"><b>✕</b> error</span><span><b>■</b> inconclusive</span><span><b>■</b> other</span></div>
  </div>
</section>
{% endif %}
<form class="filter-bar runs-filter-bar" method="get" action="/operate/runs" role="search">
  <span class="eyebrow">Result</span>
  <div class="filter-pills" role="group" aria-label="Filter by result">
    {% for pill in pills %}
    <a class="pill{% if pill.active %} pill--active{% endif %}"
       href="/operate/runs?scope={{ history_scope }}{% if pill.slug %}&outcome={{ pill.slug }}{% endif %}{% if filter_q %}&q={{ filter_q }}{% endif %}"
       aria-pressed="{{ 'true' if pill.active else 'false' }}">{{ pill.label }} ({{ pill.count }})</a>
    {% endfor %}
  </div>
  <label class="runs-filter-bar__search">
    <span class="eyebrow">Search this page</span>
    <input type="search" name="q" value="{{ filter_q or '' }}"
           placeholder="run / scenario / execution / primitive / evidence / target"
           maxlength="128" autocomplete="off">
  </label>
  {% if filter_outcome %}<input type="hidden" name="outcome" value="{{ filter_outcome }}">{% endif %}
  <input type="hidden" name="scope" value="{{ history_scope }}">
  <button type="submit" class="cta cta--ghost">Filter</button>
  {% if filter_outcome or filter_q %}
  <a class="filter-clear" href="/operate/runs?scope={{ history_scope }}">clear</a>
  {% endif %}
  <p class="filter-count" aria-live="polite">showing {{ filtered_count if filtered_count is defined else rows|length }}{% if filter_q %} page matches from {{ page_count }} loaded{% endif %} · {{ all_count if all_count is defined else rows|length }} in this result view · {{ scope_count }} in this history</p>
</form>

{% if ui == "basic" %}
{% from "operate/_partials/_deck.j2" import deck_grid with context %}
{% set cards = [] %}
{% for r in all_rows %}{% set k = run_cards.get(r.run_id) %}{% set st = r.display_status if r.display_status in ('pass','fail','error','inconclusive') else 'none' %}
{% set ended = (r.ended_at or '')[:16]|replace('T', ' ') %}
{% set exe = r.execution.value if r.execution and r.execution.value else '' %}
{% set _ = cards.append({'title': k.title, 'full_title': k.full_title ~ ' — run ' ~ r.run_id, 'id': r.run_id, 'hide_id': true,
  'href': r.run_url if r.inspectable else none, 'accent': k.implementation,
  'kicker': {'pass': '♦ pass', 'fail': '▲ fail', 'error': '✕ error', 'inconclusive': '■ inconclusive'}.get(st, '■ no result'),
  'tone': {'pass': 'dk-g-pass', 'fail': 'dk-g-fail', 'error': 'dk-g-error'}.get(st, 'dk-g-other'),
  'kicker_tone': {'pass': 'dk-g-pass', 'fail': 'dk-g-fail', 'error': 'dk-g-error'}.get(st, 'dk-g-other'),
  'sub': (ended ~ ' UTC' if ended else 'end time not recorded') ~ ((' · ' ~ r.workload_label) if r.workload_label and r.workload_label != '—' else ''),
  'tier': 'warn' if st in ('fail', 'error') else 'back', 'group': 'res:' ~ st ~ ' impl:' ~ (k.implementation or 'unknown') ~ ' meas:' ~ ('yes' if measured.get(r.run_id) else 'no'),
  'tags': ([k.implementation] if k.implementation else []) + ([r.runtime] if r.runtime else ([k.runtime] if k.runtime else [])) + k.versions + (['measured'] if measured.get(r.run_id) else []) + (['thin pass'] if r.thinness_signals else []),
  'search': r.run_id ~ ' ' ~ (r.scenario_id or '') ~ ' ' ~ exe ~ ' ' ~ (r.target_implementation or '')}) %}{% endfor %}
{% set counts = {} %}{% for c in cards %}{% set g = c.group.split(' ')[0][4:] %}{% set _ = counts.update({g: counts.get(g, 0) + 1}) %}{% endfor %}
{% set resopts = [] %}{% for v, lab in [('pass', '♦ pass'), ('fail', '▲ fail'), ('error', '✕ error'), ('inconclusive', '■ inconclusive'), ('none', '■ no result')] %}{% if counts.get(v) %}{% set _ = resopts.append((v, lab ~ ' · ' ~ counts[v])) %}{% endif %}{% endfor %}
{{ deck_grid(cards, label='runs', facets=[('res', 'Result', resopts), ('impl', 'Implementation', [('amaru', 'amaru'), ('cardano-node', 'cardano-node'), ('mixed', 'mixed')]), ('meas', 'Measurements', [('yes', 'measured'), ('no', 'not measured')])], empty='No forensic runs recorded yet.', layout='list') }}
{% endif %}
<div class="responsive-table runs-table-wrap">
{% if ui == "basic" %}<p class="b-note" style="margin:6px 0 14px">Recent runs, newest first. Filter by verdict above and open any run for its complete retained evidence.</p>{% endif %}
<table class="runs-table" data-active-status="">
  <thead>
    <tr>
      <th>Run ID</th>
      <th>Kind / state</th>
      <th>Time</th>
      <th>Scenario</th>
      <th>Execution</th>
      <th>Workload</th>
      <th>Evidence</th>
      <th>Runtime</th>
      <th>Verdict / outcome</th>
      <th>Target</th>
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
    {% include "operate/_partials/_run_row.j2" %}
    {% endfor %}
  </tbody>
</table>
</div>
{% if next_cursor %}
<p class="runs-next"><a class="cta cta--ghost" href="/operate/runs?scope={{ history_scope }}&cursor={{ next_cursor }}{% if filter_outcome %}&outcome={{ filter_outcome }}{% endif %}{% if filter_q %}&q={{ filter_q }}{% endif %}">Next 100 runs →</a></p>
{% endif %}

<script type="module">
  import {initFilter} from "/static/js/filter.js";
  initFilter({table: ".runs-table", axis: "status", label: "runs"});
</script>
{% endif %}
{% endblock %}
