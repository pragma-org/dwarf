{% extends "_base.j2" %}
{% block main %}
{% from "operate/_partials/_deck.j2" import deck_head with context %}
{{ deck_head('Primitives · New', 'Generate starter files for a new primitive.', 'Pick a family and a name, then Scaffold: DWARF writes an executor, JSON Schema, test and registry entry into a scratch scaffold folder. Nothing becomes live — the scaffold still has to be implemented, tested, merged into the registry, rebuilt into the image and deployed.') }}
<span class="eyebrow adv-only">Operate · Primitives · New primitive</span>
<h1 class="adv-only">Scaffold a new primitive</h1>
<p class="page-hero adv-only">Generate starter files for a primitive (executor, JSON Schema, test, and registry entry)—the same source scaffold as <code>cardano-profile primitive new</code>. A scaffold requires implementation, tests, registry merge, image rebuild, and deployment before it becomes live.</p>
<p><a href="/learn/primitives#authoring" target="_blank" rel="noopener">Read the primitive authoring contract</a> or <a href="/operate/primitives">browse registered primitives</a>.</p>

<style>
.mn-form{max-width:520px;margin:18px 0}
.mn-form label{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--ink-muted);margin:14px 0 3px}
.mn-form select,.mn-form input[type=text]{width:100%;background:var(--obsidian-1);border:1px solid var(--rule);color:var(--ink);border-radius:8px;padding:8px 11px;font-size:.86rem;font-family:var(--font-mono)}
.mn-form select:focus,.mn-form input:focus{outline:none;border-color:color-mix(in srgb,var(--accent) 55%,transparent)}
.mn-hint{color:var(--ink-muted);font-size:.75rem;margin:2px 0 0}
.mn-submit{margin-top:18px;background:var(--accent);color:var(--obsidian-0);border:none;border-radius:8px;padding:9px 20px;font-weight:700;font-size:.88rem;cursor:pointer}
</style>

<form class="mn-form" method="post" action="/operate/primitives/new?token={{ token }}">
  <label for="primitive-family">Family</label>
  <select id="primitive-family" name="family">{% for f in families %}<option value="{{ f }}">{{ f }}</option>{% endfor %}</select>
  <p class="mn-hint">The conceptual bucket: setup / load / probe / assertion / fault / teardown.</p>
  <label for="primitive-name">Primitive name</label>
  <input id="primitive-name" type="text" name="name" placeholder="my_new_primitive" required>
  <p class="mn-hint">Starts with a letter; lowercase letters/digits/underscore; 3–80 chars.</p>
  <button class="mn-submit" type="submit">Scaffold primitive</button>
</form>
{% endblock %}
